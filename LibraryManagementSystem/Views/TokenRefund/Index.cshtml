@model IEnumerable<LibraryManagementSystem.ClassLibrary.Models.TokenRefund>

@{
    ViewData["Title"] = "Token Refund Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

    :root {
        --bg: #f3f6fb;
        --card: #ffffff;
        --card2: #f8fafc;
        --text: #0f172a;
        --subtext: #64748b;
        --border: #e2e8f0;
        --shadow: 0 10px 35px rgba(15,23,42,0.06);
        --hover-shadow: 0 18px 45px rgba(15,23,42,0.12);
        --green: linear-gradient(135deg,#16a34a,#22c55e);
        --red: linear-gradient(135deg,#dc2626,#ef4444);
        --blue: linear-gradient(135deg,#3b82f6,#60a5fa);
        --orange: linear-gradient(135deg,#f59e0b,#fbbf24);
        --radius: 28px;
    }

    body {
        background: var(--bg);
        font-family: 'Inter',sans-serif;
        color: var(--text);
    }

    .approval-page {
        padding: 35px;
    }

    /* HEADER */
    .page-title h2 {
        font-size: 42px;
        font-weight: 900;
    }

    .page-subtitle {
        color: var(--subtext);
    }

    /* GRID */
    .approval-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(380px,1fr));
        gap: 25px;
    }

    /* CARD */
    .approval-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 26px;
        box-shadow: var(--shadow);
        transition: .3s ease;
        position: relative;
        overflow: hidden;
    }

        .approval-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--hover-shadow);
        }

    /* TOP */
    .top-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .user-box {
        display: flex;
        gap: 14px;
        align-items: center;
    }

    .avatar {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: var(--blue);
        color: #fff;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    /* STATUS */
    .status-badge {
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
    }

    .pending {
        background: #fef3c7;
        color: #92400e;
    }

    .approved {
        background: #dcfce7;
        color: #166534;
    }

    .rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    /* DETAILS */
    .details-box {
        background: var(--card2);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 16px;
        margin-bottom: 18px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid var(--border);
    }

        .detail-row:last-child {
            border: none;
        }

    .detail-label {
        color: var(--subtext);
        font-size: 13px;
    }

    .detail-value {
        font-weight: 800;
        font-size: 14px;
    }

    /* REFUND HIGHLIGHT */
    .refund-highlight {
        background: linear-gradient(135deg,rgba(34,197,94,.12),rgba(16,185,129,.08));
        border: 1px solid rgba(34,197,94,.25);
        border-radius: 18px;
        padding: 16px;
        text-align: center;
        margin-bottom: 18px;
    }

        .refund-highlight .amount {
            font-size: 26px;
            font-weight: 900;
            color: #16a34a;
        }

        .refund-highlight .label {
            font-size: 13px;
            color: var(--subtext);
        }

    /* CONDITION BADGES */
    .condition {
        display: inline-flex;
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
    }

    .excellent {
        background: #dcfce7;
        color: #166534;
    }

    .good {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .damaged {
        background: #fef3c7;
        color: #92400e;
    }

    .lost {
        background: #fee2e2;
        color: #991b1b;
    }

    /* ACTIONS */
    .actions {
        display: flex;
        gap: 12px;
    }

    .btn-approve,
    .btn-reject {
        flex: 1;
        padding: 13px;
        border: none;
        border-radius: 14px;
        font-weight: 800;
        color: #fff;
        cursor: pointer;
    }

    .btn-approve {
        background: var(--green);
    }

    .btn-reject {
        background: var(--red);
    }

    /* EMPTY */
    .empty-box {
        text-align: center;
        padding: 80px;
        background: var(--card);
        border-radius: 30px;
        margin-top:30px;
    }
</style>

<div class="approval-page">

    <div class="page-header">
        <div class="page-title">
            <h2>💰 Token Refund Management</h2>
        </div>
        <div class="page-subtitle">
            Review and process refund requests
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-box">
            <i class="bi bi-cash-coin fs-1"></i>
            <h3>No Refund Requests</h3>
            <p>All refunds are up to date.</p>
        </div>
    }
    else
    {
        <div class="approval-grid">

            @foreach (var item in Model)
            {
                var name = item.UserToken?.User?.FullName ?? "User";
                var initial = name.Length > 0 ? name.Substring(0, 1).ToUpper() : "U";

                <div class="approval-card">

                    <!-- TOP -->
                    <div class="top-section">

                        <div class="user-box">
                            <div class="avatar">@initial</div>
                            <div>
                                <div class="fw-bold">@name</div>
                                <div class="text-muted small">
                                    @item.UserToken?.User?.Email
                                </div>
                            </div>
                        </div>

                        <div class="status-badge @item.RefundStatus.ToLower()">
                            @item.RefundStatus
                        </div>

                    </div>

                    <!-- REFUND AMOUNT -->
                    @if (item.RefundAmount > 0)
                    {
                        <div class="refund-highlight">
                            <div class="amount">₹@item.RefundAmount</div>
                            <div class="label">Refund Amount</div>
                        </div>
                    }

                    <!-- DETAILS -->
                    <div class="details-box">

                        <div class="detail-row">
                            <div class="detail-label">Book</div>
                            <div class="detail-value">@item.BorrowRecord?.Book?.Title</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Deposit</div>
                            <div class="detail-value">₹@item.DepositAmount</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Fine</div>
                            <div class="detail-value">₹@item.FineAmount</div>
                        </div>

                        <div class="detail-row">
                            <div class="detail-label">Requested On</div>
                            <div class="detail-value">@item.CreatedOn.ToString("dd MMM yyyy")</div>
                        </div>

                    </div>

                    <!-- CONDITION -->
                    @if (!string.IsNullOrEmpty(item.BookCondition))
                    {
                        <div class="condition @item.BookCondition.ToLower() mb-3">
                            @item.BookCondition
                        </div>
                    }

                    <!-- ACTIONS -->
                    @if (item.RefundStatus == "Pending")
                    {
                        <div class="actions">

                            <form asp-action="Approve" method="post" style="flex:1;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />

                                <button class="btn-approve">
                                    <i class="bi bi-check-circle"></i> Approve
                                </button>
                            </form>

                            <form asp-action="Reject" method="post" style="flex:1;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />

                                <button class="btn-reject">
                                    <i class="bi bi-x-circle"></i> Reject
                                </button>
                            </form>

                        </div>
                    }

                </div>
            }

        </div>
    }

</div>
