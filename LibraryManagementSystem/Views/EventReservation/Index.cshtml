@model List<LibraryManagementSystem.ClassLibrary.Models.EventReservation>

@{
    ViewData["Title"] = "Event Reservations";

    var pendingCount = Model.Count(x =>
        x.Status != null &&
        x.Status.Trim().ToLower() == "pending");

    var approvedCount = Model.Count(x =>
        x.Status != null &&
        x.Status.Trim().ToLower() == "approved");

    var rejectedCount = Model.Count(x =>
        x.Status != null &&
        x.Status.Trim().ToLower() == "rejected");
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

    body {
        background: #050816;
        color: white;
        font-family: 'Inter', sans-serif;
    }

    .page {
        padding: 35px;
    }

    .top-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .page-title {
        font-size: 38px;
        font-weight: 800;
        margin: 0;
        color: #050816;
    }

    .page-subtitle {
        color: #94a3b8;
        margin-top: 6px;
        font-size: 15px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: linear-gradient(145deg,#0f172a,#111827);
        border-radius: 22px;
        padding: 24px;
        border: 1px solid rgba(255,255,255,0.06);
        position: relative;
        overflow: hidden;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            width: 120px;
            height: 120px;
            background: rgba(255,255,255,0.04);
            border-radius: 50%;
            top: -40px;
            right: -40px;
        }

    .stat-label {
        color: #94a3b8;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 34px;
        font-weight: 800;
    }

    .pending-text {
        color: #f59e0b;
    }

    .approved-text {
        color: #10b981;
    }

    .rejected-text {
        color: #ef4444;
    }

    .reservation-card {
        background: linear-gradient(145deg,#0f172a,#111827);
        border-radius: 26px;
        padding: 26px;
        margin-bottom: 24px;
        border: 1px solid rgba(255,255,255,0.05);
        transition: .3s ease;
    }

        .reservation-card:hover {
            transform: translateY(-4px);
        }

    .card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        flex-wrap: wrap;
    }

    .event-title {
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .event-location {
        color: #94a3b8;
        font-size: 14px;
    }

    .member-name {
        margin-top: 14px;
        font-size: 15px;
        color: #e5e7eb;
    }

    .status-badge {
        padding: 10px 18px;
        border-radius: 40px;
        font-size: 13px;
        font-weight: 700;
        display: inline-block;
    }

    .pending {
        background: rgba(245,158,11,.15);
        color: #f59e0b;
    }

    .approved {
        background: rgba(16,185,129,.15);
        color: #10b981;
    }

    .rejected {
        background: rgba(239,68,68,.15);
        color: #ef4444;
    }

    .unknown {
        background: rgba(107,114,128,.15);
        color: #d1d5db;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 18px;
        margin-top: 24px;
    }

    .info-box {
        background: rgba(255,255,255,0.04);
        border-radius: 16px;
        padding: 18px;
    }

    .info-label {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 8px;
    }

    .info-value {
        font-size: 17px;
        font-weight: 700;
    }

    .action-area {
        margin-top: 24px;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

    .btn-action {
        border: none;
        border-radius: 14px;
        padding: 12px 20px;
        font-weight: 700;
        color: white;
        transition: .3s;
    }

        .btn-action:hover {
            transform: translateY(-2px);
            opacity: .9;
        }

    .btn-approve {
        background: linear-gradient(135deg,#10b981,#059669);
    }

    .btn-reject {
        background: linear-gradient(135deg,#ef4444,#dc2626);
    }

    .completed-box {
        margin-top: 22px;
        color: #94a3b8;
        font-weight: 600;
    }

    .empty-box {
        background: linear-gradient(145deg,#0f172a,#111827);
        border-radius: 24px;
        padding: 80px 20px;
        text-align: center;
        color: #94a3b8;
        border: 1px solid rgba(255,255,255,0.05);
    }

    @@media(max-width:992px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .page {
            padding: 20px;
        }

        .page-title {
            font-size: 30px;
        }

        .event-title {
            font-size: 20px;
        }
    }

</style>

<div class="page">

    <div class="top-section">

        <div>

            <h1 class="page-title">
                🎟️ Event Reservations
            </h1>

            <div class="page-subtitle">
                Manage all member event reservation requests
            </div>

        </div>

    </div>

    <div class="stats-grid">

        <div class="stat-card">

            <div class="stat-label">
                Pending Reservations
            </div>

            <div class="stat-value pending-text">
                @pendingCount
            </div>

        </div>

        <div class="stat-card">

            <div class="stat-label">
                Approved Reservations
            </div>

            <div class="stat-value approved-text">
                @approvedCount
            </div>

        </div>

        <div class="stat-card">

            <div class="stat-label">
                Rejected Reservations
            </div>

            <div class="stat-value rejected-text">
                @rejectedCount
            </div>

        </div>

    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            var status = item.Status?.Trim().ToLower();

            <div class="reservation-card">

                <div class="card-top">

                    <div>

                        <div class="event-title">
                            @item.Event?.Title
                        </div>

                        <div class="event-location">
                            📍 @item.Event?.Location
                        </div>

                        <div class="member-name">
                            👤 @item.Member?.Name
                        </div>

                    </div>

                    <div>

                        @switch (status)
                        {
                            case "pending":

                                <span class="status-badge pending">
                                    Pending
                                </span>

                                break;

                            case "approved":

                                <span class="status-badge approved">
                                    Approved
                                </span>

                                break;

                            case "rejected":

                                <span class="status-badge rejected">
                                    Rejected
                                </span>

                                break;

                            default:

                                <span class="status-badge unknown">
                                    Unknown
                                </span>

                                break;
                        }

                    </div>

                </div>

                <div class="info-grid">

                    <div class="info-box">

                        <div class="info-label">
                            Reserved On
                        </div>

                        <div class="info-value">
                            @item.ReservedOn.ToString("dd MMM yyyy")
                        </div>

                    </div>

                    <div class="info-box">

                        <div class="info-label">
                            Reservation Time
                        </div>

                        <div class="info-value">
                            @item.ReservedOn.ToString("hh:mm tt")
                        </div>

                    </div>

                    <div class="info-box">

                        <div class="info-label">
                            Current Status
                        </div>

                        <div class="info-value">
                            @(item.Status ?? "Unknown")
                        </div>

                    </div>

                </div>

                @if (status == "pending")
                {
                    <div class="action-area">

                        <form asp-controller="EventReservation"
                              asp-action="Approve"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn-action btn-approve">

                                ✓ Approve Reservation

                            </button>

                        </form>

                        <form asp-controller="EventReservation"
                              asp-action="Reject"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn-action btn-reject">

                                ✕ Reject Reservation

                            </button>

                        </form>

                    </div>
                }
                else
                {
                    <div class="completed-box">
                        Reservation process completed.
                    </div>
                }

            </div>
        }
    }
    else
    {
        <div class="empty-box">

            <h3>
                No Event Reservations Found
            </h3>

            <p>
                There are currently no reservation requests available.
            </p>

        </div>
    }

</div>
