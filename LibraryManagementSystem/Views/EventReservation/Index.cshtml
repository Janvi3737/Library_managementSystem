@model List<LibraryManagementSystem.ClassLibrary.Models.EventReservation>

@{
    ViewData["Title"] = "Event Reservations";

    var pendingCount = Model.Count(x =>
        x.Status != null &&
        x.Status.Trim().ToLower() == "pending");

    var approvedCount = Model.Count(x =>
        x.Status != null &&
        x.Status.Trim().ToLower() == "approved");

    var rejectedCount = Model.Count(x =>
        x.Status != null &&
        x.Status.Trim().ToLower() == "rejected");
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
@@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

/* ========================================
   ROOT VARIABLES
======================================== */

:root{

    --bg:#f3f6fb;
    --card:#ffffff;
    --card2:#f8fafc;

    --text:#0f172a;
    --subtext:#64748b;

    --border:#e2e8f0;

    --shadow:
        0 10px 35px rgba(15,23,42,0.06);

    --hover-shadow:
        0 18px 45px rgba(15,23,42,0.10);

    --purple:
        linear-gradient(135deg,#7c3aed,#a855f7);

    --green:
        linear-gradient(135deg,#10b981,#059669);

    --red:
        linear-gradient(135deg,#ef4444,#dc2626);

    --radius:28px;
}

/* ========================================
   DARK MODE
======================================== */

[data-bs-theme="dark"]{

    --bg:#020617;

    --card:
        linear-gradient(145deg,#0f172a,#111827);

    --card2:#111827;

    --text:#f8fafc;

    --subtext:#94a3b8;

    --border:rgba(255,255,255,0.08);

    --shadow:
        0 15px 45px rgba(0,0,0,0.45);

    --hover-shadow:
        0 20px 55px rgba(0,0,0,0.60);
}

/* ========================================
   BODY
======================================== */

body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    transition:all .35s ease;
}

/* ========================================
   PAGE
======================================== */

.page{
    padding:35px;
}

/* ========================================
   HEADER
======================================== */

.top-section{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:35px;
    gap:20px;
    flex-wrap:wrap;
}

.page-title{
    font-size:44px;
    font-weight:800;
    margin:0;
    color:var(--text);
    letter-spacing:-1px;
}

.page-subtitle{
    margin-top:10px;
    color:var(--subtext);
    font-size:16px;
    font-weight:500;
}

/* ========================================
   STATS GRID
======================================== */

.stats-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:24px;
    margin-bottom:35px;
}

/* ========================================
   STAT CARD
======================================== */

.stat-card{
    position:relative;
    overflow:hidden;

    background:var(--card);

    border:1px solid var(--border);

    border-radius:var(--radius);

    padding:30px;

    box-shadow:var(--shadow);

    transition:.35s ease;
}

.stat-card:hover{
    transform:translateY(-6px);
    box-shadow:var(--hover-shadow);
}

.stat-card::before{
    content:'';

    position:absolute;

    width:160px;
    height:160px;

    border-radius:50%;

    top:-70px;
    right:-70px;

    background:
        rgba(168,85,247,0.08);
}

[data-bs-theme="dark"] .stat-card::before{

    background:
        rgba(168,85,247,0.12);
}

.stat-label{
    font-size:15px;
    font-weight:600;
    color:var(--subtext);
    margin-bottom:18px;
}

.stat-value{
    font-size:52px;
    font-weight:800;
    line-height:1;
}

/* ========================================
   COLORS
======================================== */

.pending-text{
    color:#f59e0b;
}

.approved-text{
    color:#10b981;
}

.rejected-text{
    color:#ef4444;
}

/* ========================================
   RESERVATION CARD
======================================== */

.reservation-card{

    background:var(--card);

    border:1px solid var(--border);

    border-radius:32px;

    padding:35px;

    margin-bottom:28px;

    box-shadow:var(--shadow);

    transition:.35s ease;
}

.reservation-card:hover{
    transform:translateY(-5px);
    box-shadow:var(--hover-shadow);
}

/* ========================================
   CARD TOP
======================================== */

.card-top{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:20px;
    flex-wrap:wrap;
}

/* ========================================
   TITLE
======================================== */

.event-title{
    font-size:40px;
    font-weight:800;
    color:var(--text);
    margin-bottom:10px;
    letter-spacing:-1px;
}

.event-location{
    color:var(--subtext);
    font-size:16px;
    font-weight:600;
}

.member-name{
    margin-top:18px;
    font-size:19px;
    font-weight:700;
    color:var(--text);
}

/* ========================================
   STATUS BADGE
======================================== */

.status-badge{
    padding:13px 24px;

    border-radius:999px;

    font-size:14px;
    font-weight:700;

    min-width:140px;

    text-align:center;

    display:inline-flex;
    align-items:center;
    justify-content:center;
}

/* ========================================
   BADGE COLORS
======================================== */

.pending{
    background:rgba(245,158,11,0.15);
    color:#f59e0b;
}

.approved{
    background:rgba(16,185,129,0.15);
    color:#10b981;
}

.rejected{
    background:rgba(239,68,68,0.15);
    color:#ef4444;
}

.unknown{
    background:rgba(148,163,184,0.15);
    color:#94a3b8;
}

/* ========================================
   INFO GRID
======================================== */

.info-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
    margin-top:32px;
}

/* ========================================
   INFO BOX
======================================== */

.info-box{

    background:var(--card2);

    border:1px solid var(--border);

    border-radius:22px;

    padding:24px;

    transition:.3s ease;
}

.info-box:hover{
    transform:translateY(-3px);
}

.info-label{
    font-size:14px;
    font-weight:600;
    color:var(--subtext);
    margin-bottom:12px;
}

.info-value{
    font-size:20px;
    font-weight:800;
    color:var(--text);
}

/* ========================================
   ACTION AREA
======================================== */

.action-area{
    margin-top:30px;
    display:flex;
    gap:16px;
    flex-wrap:wrap;
}

/* ========================================
   BUTTONS
======================================== */

.btn-action{
    border:none;

    padding:14px 24px;

    border-radius:18px;

    color:white;

    font-size:14px;
    font-weight:700;

    cursor:pointer;

    transition:.3s ease;
}

.btn-action:hover{
    transform:translateY(-3px);
}

.btn-approve{
    background:var(--green);

    box-shadow:
        0 10px 24px rgba(16,185,129,0.25);
}

.btn-reject{
    background:var(--red);

    box-shadow:
        0 10px 24px rgba(239,68,68,0.25);
}

/* ========================================
   COMPLETED BOX
======================================== */

.completed-box{

    margin-top:28px;

    padding-top:24px;

    border-top:1px solid var(--border);

    color:var(--subtext);

    font-size:16px;
    font-weight:600;
}

/* ========================================
   EMPTY BOX
======================================== */

.empty-box{

    background:var(--card);

    border:1px solid var(--border);

    border-radius:32px;

    padding:100px 25px;

    text-align:center;

    box-shadow:var(--shadow);
}

.empty-box h3{
    font-size:34px;
    font-weight:800;
    margin-bottom:15px;
    color:var(--text);
}

.empty-box p{
    color:var(--subtext);
    font-size:16px;
    margin:0;
}

/* ========================================
   RESPONSIVE
======================================== */

@@media(max-width:1100px){

    .stats-grid{
        grid-template-columns:1fr;
    }

    .info-grid{
        grid-template-columns:1fr;
    }
}

@@media(max-width:768px){

    .page{
        padding:20px;
    }

    .page-title{
        font-size:34px;
    }

    .event-title{
        font-size:28px;
    }

    .reservation-card{
        padding:24px;
    }

    .card-top{
        flex-direction:column;
    }

    .status-badge{
        margin-top:10px;
    }
}

@@media(max-width:480px){

    .page-title{
        font-size:28px;
    }

    .event-title{
        font-size:24px;
    }

    .member-name{
        font-size:16px;
    }

    .stat-value{
        font-size:40px;
    }

    .btn-action{
        width:100%;
    }
}
</style>

<div class="page">

    <div class="top-section">

        <div>

            <h1 class="page-title">
                🎟️ Event Reservations
            </h1>

            <div class="page-subtitle">
                Manage all member event reservation requests
            </div>

        </div>

    </div>

    <div class="stats-grid">

        <div class="stat-card">

            <div class="stat-label">
                Pending Reservations
            </div>

            <div class="stat-value pending-text">
                @pendingCount
            </div>

        </div>

        <div class="stat-card">

            <div class="stat-label">
                Approved Reservations
            </div>

            <div class="stat-value approved-text">
                @approvedCount
            </div>

        </div>

        <div class="stat-card">

            <div class="stat-label">
                Rejected Reservations
            </div>

            <div class="stat-value rejected-text">
                @rejectedCount
            </div>

        </div>

    </div>

    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            var status = item.Status?.Trim().ToLower();

            <div class="reservation-card">

                <div class="card-top">

                    <div>

                        <div class="event-title">
                            @item.Event?.Title
                        </div>

                        <div class="event-location">
                            📍 @item.Event?.Location
                        </div>

                        <div class="member-name">
                            👤 @item.Member?.Name
                        </div>

                    </div>

                    <div>

                        @switch (status)
                        {
                            case "pending":

                                <span class="status-badge pending">
                                    Pending
                                </span>

                                break;

                            case "approved":

                                <span class="status-badge approved">
                                    Approved
                                </span>

                                break;

                            case "rejected":

                                <span class="status-badge rejected">
                                    Rejected
                                </span>

                                break;

                            default:

                                <span class="status-badge unknown">
                                    Unknown
                                </span>

                                break;
                        }

                    </div>

                </div>

                <div class="info-grid">

                    <div class="info-box">

                        <div class="info-label">
                            Reserved On
                        </div>

                        <div class="info-value">
                            @item.ReservedOn.ToString("dd MMM yyyy")
                        </div>

                    </div>

                    <div class="info-box">

                        <div class="info-label">
                            Reservation Time
                        </div>

                        <div class="info-value">
                            @item.ReservedOn.ToString("hh:mm tt")
                        </div>

                    </div>

                    <div class="info-box">

                        <div class="info-label">
                            Current Status
                        </div>

                        <div class="info-value">
                            @(item.Status ?? "Unknown")
                        </div>

                    </div>

                </div>

                @if (status == "pending")
                {
                    <div class="action-area">

                        <form asp-controller="EventReservation"
                              asp-action="Approve"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn-action btn-approve">

                                ✓ Approve Reservation

                            </button>

                        </form>

                        <form asp-controller="EventReservation"
                              asp-action="Reject"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn-action btn-reject">

                                ✕ Reject Reservation

                            </button>

                        </form>

                    </div>
                }
                else
                {
                    <div class="completed-box">
                        Reservation process completed.
                    </div>
                }

            </div>
        }
    }
    else
    {
        <div class="empty-box">

            <h3>
                No Event Reservations Found
            </h3>

            <p>
                There are currently no reservation requests available.
            </p>

        </div>
    }

</div>
