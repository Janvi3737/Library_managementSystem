@model IEnumerable<LibraryManagementSystem.ClassLibrary.Models.MembershipPayment>

@{
    ViewData["Title"] = "Membership Approvals";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
@@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

/* ========================================
   ROOT VARIABLES
======================================== */

:root{

    --bg:#f3f6fb;

    --card:#ffffff;

    --card2:#f8fafc;

    --text:#0f172a;

    --subtext:#64748b;

    --border:#e2e8f0;

    --shadow:
        0 10px 35px rgba(15,23,42,0.06);

    --hover-shadow:
        0 18px 45px rgba(15,23,42,0.12);

    --purple:
        linear-gradient(135deg,#7c3aed,#a855f7);

    --green:
        linear-gradient(135deg,#16a34a,#22c55e);

    --red:
        linear-gradient(135deg,#dc2626,#ef4444);

    --radius:30px;
}

/* ========================================
   DARK MODE
======================================== */

[data-bs-theme="dark"]{

    --bg:#020617;

    --card:
        linear-gradient(145deg,#0f172a,#111827);

    --card2:#111827;

    --text:#f8fafc;

    --subtext:#94a3b8;

    --border:
        rgba(255,255,255,0.08);

    --shadow:
        0 15px 45px rgba(0,0,0,0.45);

    --hover-shadow:
        0 22px 55px rgba(0,0,0,0.65);
}

/* ========================================
   BODY
======================================== */

body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    transition:.35s ease;
}

/* ========================================
   PAGE
======================================== */

.approval-page{
    padding:35px;
}

/* ========================================
   HEADER
======================================== */

.page-header{
    margin-bottom:35px;
}

.page-title{

    font-size:44px;

    font-weight:900;

    color:var(--text);

    margin-bottom:10px;

    letter-spacing:-1px;
}

.page-title h2{
    margin:0;
    font-size:inherit;
    font-weight:inherit;
    color:inherit;
}

.page-subtitle{
    color:var(--subtext);
    font-size:16px;
    font-weight:500;
}

/* ========================================
   GRID
======================================== */

.approval-grid{
    display:grid;
    grid-template-columns:
        repeat(auto-fit,minmax(420px,1fr));

    gap:28px;
}

/* ========================================
   CARD
======================================== */

.approval-card{

    background:var(--card);

    border:1px solid var(--border);

    border-radius:var(--radius);

    padding:30px;

    position:relative;

    overflow:hidden;

    box-shadow:var(--shadow);

    transition:.35s ease;
}

.approval-card:hover{

    transform:translateY(-6px);

    box-shadow:var(--hover-shadow);
}

.approval-card::before{

    content:'';

    position:absolute;

    width:180px;
    height:180px;

    border-radius:50%;

    top:-90px;
    right:-90px;

    background:
        rgba(168,85,247,0.08);
}

[data-bs-theme="dark"] .approval-card::before{

    background:
        rgba(168,85,247,0.12);
}

/* ========================================
   TOP SECTION
======================================== */

.top-section{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:20px;
    margin-bottom:28px;
    flex-wrap:wrap;
}

/* ========================================
   USER BOX
======================================== */

.user-box{
    display:flex;
    align-items:center;
    gap:18px;
}

/* ========================================
   AVATAR
======================================== */

.avatar{

    width:64px;
    height:64px;

    border-radius:20px;

    background:var(--purple);

    display:flex;
    align-items:center;
    justify-content:center;

    color:white;

    font-size:24px;
    font-weight:800;

    box-shadow:
        0 12px 24px rgba(124,58,237,0.25);
}

/* ========================================
   USER INFO
======================================== */

.user-name{
    font-size:22px;
    font-weight:800;
    color:var(--text);
}

.user-email{
    margin-top:5px;
    color:var(--subtext);
    font-size:14px;
    font-weight:500;
}

/* ========================================
   STATUS BADGE
======================================== */

.status-badge{

    padding:11px 18px;

    border-radius:999px;

    font-size:13px;

    font-weight:700;

    display:inline-flex;
    align-items:center;
    justify-content:center;

    min-width:110px;
}

/* ========================================
   STATUS COLORS
======================================== */

.pending{
    background:rgba(251,191,36,0.14);
    color:#facc15;
}

.approved{
    background:rgba(34,197,94,0.14);
    color:#4ade80;
}

.rejected{
    background:rgba(239,68,68,0.14);
    color:#f87171;
}

/* ========================================
   DETAILS BOX
======================================== */

.details-box{

    background:var(--card2);

    border:1px solid var(--border);

    border-radius:24px;

    padding:22px;

    margin-bottom:28px;
}

/* ========================================
   DETAIL ROW
======================================== */

.detail-row{

    display:flex;

    justify-content:space-between;

    align-items:center;

    gap:20px;

    padding:14px 0;

    border-bottom:1px solid var(--border);
}

.detail-row:last-child{
    border-bottom:none;
}

/* ========================================
   DETAIL TEXT
======================================== */

.detail-label{
    color:var(--subtext);
    font-size:14px;
    font-weight:500;
}

.detail-value{
    color:var(--text);
    font-size:15px;
    font-weight:700;
    text-align:right;
}

/* ========================================
   PROOF BOX
======================================== */

.proof-box{
    margin-bottom:28px;
}

.proof-title{
    font-size:15px;
    font-weight:700;
    color:var(--text);
    margin-bottom:14px;
}

.proof-img{

    width:100%;

    height:260px;

    object-fit:cover;

    border-radius:22px;

    border:1px solid var(--border);

    box-shadow:
        0 8px 25px rgba(0,0,0,0.08);
}

/* ========================================
   ACTION BUTTONS
======================================== */

.action-buttons{
    display:flex;
    gap:16px;
}

/* ========================================
   BUTTONS
======================================== */

.approve-btn,
.reject-btn{

    flex:1;

    border:none;

    padding:16px;

    border-radius:18px;

    font-size:15px;

    font-weight:800;

    color:white;

    cursor:pointer;

    transition:.3s ease;
}

.approve-btn{

    background:var(--green);

    box-shadow:
        0 10px 25px rgba(34,197,94,0.22);
}

.reject-btn{

    background:var(--red);

    box-shadow:
        0 10px 25px rgba(239,68,68,0.22);
}

.approve-btn:hover,
.reject-btn:hover{

    transform:translateY(-3px);
}

/* ========================================
   EMPTY BOX
======================================== */

.empty-box{

    background:var(--card);

    border:1px solid var(--border);

    border-radius:34px;

    padding:90px 30px;

    text-align:center;

    box-shadow:var(--shadow);
}

.empty-icon{

    font-size:72px;

    margin-bottom:22px;

    color:#a855f7;
}

.empty-title{

    font-size:34px;

    font-weight:900;

    color:var(--text);

    margin-bottom:14px;
}

.empty-text{

    color:var(--subtext);

    font-size:16px;
}

/* ========================================
   RESPONSIVE
======================================== */

@@media(max-width:992px){

    .approval-grid{
        grid-template-columns:1fr;
    }
}

@@media(max-width:768px){

    .approval-page{
        padding:20px;
    }

    .page-title{
        font-size:34px;
    }

    .approval-card{
        padding:24px;
    }

    .top-section{
        flex-direction:column;
        align-items:flex-start;
    }

    .action-buttons{
        flex-direction:column;
    }

    .detail-row{
        flex-direction:column;
        align-items:flex-start;
    }

    .detail-value{
        text-align:left;
    }
}

@@media(max-width:480px){

    .page-title{
        font-size:28px;
    }

    .user-name{
        font-size:18px;
    }

    .avatar{
        width:56px;
        height:56px;
        font-size:20px;
    }

    .approval-card{
        padding:20px;
        border-radius:24px;
    }
}
</style>

<div class="approval-page">

    <!-- HEADER -->

    <div class="page-header">

        <div class="page-title">
           <h2 class="m-0">👤 Membership Approvals</h2>
        </div>

        <div class="page-subtitle">
            Review membership payments and approve user subscriptions
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="empty-box">

            <div class="empty-icon">
                <i class="bi bi-patch-check-fill"></i>
            </div>

            <div class="empty-title">
                No Membership Requests
            </div>

            <div class="empty-text">
                There are currently no pending membership approvals.
            </div>

        </div>
    }
    else
    {
        <div class="approval-grid">

            @foreach (var item in Model)
            {
                <div class="approval-card">

                    <!-- TOP -->

                    <div class="top-section">

                        <div class="user-box">

                            <div class="avatar">
                                @(item.Membership.Member.Name.Substring(0,1).ToUpper())
                            </div>

                            <div>

                                <div class="user-name">
                                    @item.Membership.Member.Name
                                </div>

                                <div class="user-email">
                                    @item.Membership.Member.Email
                                </div>

                            </div>

                        </div>

                        <div>

                            @if(item.PaymentStatus == "Pending")
                            {
                                <div class="status-badge pending">
                                    Pending
                                </div>
                            }

                            @if(item.PaymentStatus == "Approved")
                            {
                                <div class="status-badge approved">
                                    Approved
                                </div>
                            }

                            @if(item.PaymentStatus == "Rejected")
                            {
                                <div class="status-badge rejected">
                                    Rejected
                                </div>
                            }

                        </div>

                    </div>

                    <!-- DETAILS -->

                    <div class="details-box">

                        <div class="detail-row">

                            <div class="detail-label">
                                Membership
                            </div>

                            <div class="detail-value">
                                @item.Membership.MembershipType
                            </div>

                        </div>

                        <div class="detail-row">

                            <div class="detail-label">
                                Amount
                            </div>

                            <div class="detail-value">
                                ₹@item.Amount
                            </div>

                        </div>

                        <div class="detail-row">

                            <div class="detail-label">
                                Payment Method
                            </div>

                            <div class="detail-value">
                                @item.PaymentMethod
                            </div>

                        </div>

                        <div class="detail-row">

                            <div class="detail-label">
                                Transaction ID
                            </div>

                            <div class="detail-value">
                                @item.TransactionId
                            </div>

                        </div>

                        <div class="detail-row">

                            <div class="detail-label">
                                Payment Date
                            </div>

                            <div class="detail-value">
                                @item.PaymentDate.ToString("dd MMM yyyy")
                            </div>

                        </div>

                    </div>

                    <!-- SCREENSHOT -->

                    @* @if(!string.IsNullOrEmpty(item.ScreenshotPath))
                    {
                        <div class="proof-box">

                            <div class="proof-title">
                                Payment Screenshot
                            </div>

                            <img src="@item.ScreenshotPath"
                                 class="proof-img" />

                        </div>
                    } *@

                    <!-- ACTIONS -->

                    @if(item.PaymentStatus == "Pending")
                    {
                        <div class="action-buttons">

                            <form asp-action="Approve"
                                  method="post"
                                  style="flex:1;">

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="approve-btn">

                                    <i class="bi bi-check-circle-fill"></i>
                                    Approve

                                </button>

                            </form>

                            <form asp-action="Reject"
                                  method="post"
                                  style="flex:1;">

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="reject-btn">

                                    <i class="bi bi-x-circle-fill"></i>
                                    Reject

                                </button>

                            </form>

                        </div>
                    }

                </div>
            }

        </div>
    }

</div>