@model LibraryManagementSystem.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Reports & Analytics";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
    /* ==================================================
       RESET
    ================================================== */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    /* ==================================================
       LIGHT THEME
    ================================================== */

    :root {
        --bg: #f8fafc;
        --card: #ffffff;
        --card2: #f1f5f9;
        --text: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
        --primary: #6366f1;
        --primary2: #8b5cf6;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --info: #06b6d4;
        --shadow: 0 10px 25px rgba(15,23,42,.08);
        --hover: rgba(99,102,241,.05);
    }

    /* ==================================================
       DARK THEME
    ================================================== */

    [data-bs-theme="dark"] {
        --bg: #0f172a;
        --card: #111827;
        --card2: #1e293b;
        --text: #f8fafc;
        --muted: #94a3b8;
        --border: rgba(255,255,255,.08);
        --primary: #818cf8;
        --primary2: #a78bfa;
        --success: #34d399;
        --danger: #f87171;
        --warning: #fbbf24;
        --info: #22d3ee;
        --shadow: 0 12px 40px rgba(0,0,0,.35);
        --hover: rgba(255,255,255,.03);
    }

    /* ==================================================
       BODY
    ================================================== */

    body {
        font-family: 'Inter',sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
    }

    [data-bs-theme="dark"] body {
        background: radial-gradient( circle at top right, rgba(99,102,241,.12), transparent 35% ), var(--bg);
    }

    /* ==================================================
       PAGE
    ================================================== */

    .reports-page {
        padding: 35px;
    }

    .page-title {
        font-size: 38px;
        font-weight: 800;
        color: var(--text);
        margin-bottom: 8px;
    }

    .page-subtitle {
        color: var(--muted);
        font-size: 15px;
        margin-bottom: 30px;
    }

    /* ==================================================
       STATS
    ================================================== */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
        gap: 24px;
        margin-bottom: 35px;
    }

    .stat-card {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 30px;
        color: white;
        box-shadow: var(--shadow);
        transition: .3s ease;
    }

        .stat-card:hover {
            transform: translateY(-6px);
        }

        .stat-card::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            top: -70px;
            right: -70px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }

    .card-1 {
        background: linear-gradient(135deg,#4f46e5,#7c3aed);
    }

    .card-2 {
        background: linear-gradient(135deg,#0891b2,#06b6d4);
    }

    .card-3 {
        background: linear-gradient(135deg,#059669,#10b981);
    }

    .card-4 {
        background: linear-gradient(135deg,#dc2626,#f43f5e);
    }

    .stat-icon {
        font-size: 34px;
        margin-bottom: 15px;
    }

    .stat-title {
        font-size: 14px;
        opacity: .9;
    }

    .stat-value {
        font-size: 42px;
        font-weight: 800;
    }

    /* ==================================================
       CONTENT GRID
    ================================================== */

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-bottom: 30px;
    }

    /* ==================================================
       CARDS
    ================================================== */

    .report-card,
    .chart-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 24px;
        box-shadow: var(--shadow);
        transition: .3s ease;
    }

        .report-card:hover,
        .chart-card:hover {
            transform: translateY(-4px);
        }

    .card-title {
        font-size: 22px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* ==================================================
       TABLES
    ================================================== */

    .table-responsive {
        border-radius: 18px;
        overflow: hidden;
    }

    .table {
        width: 100%;
        margin-bottom: 0;
        background: var(--card);
        color: var(--text);
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead {
            background: var(--card2);
        }

            .table thead th {
                padding: 16px;
                border: none !important;
                color: var(--muted);
                font-size: 13px;
                font-weight: 700;
                letter-spacing: .5px;
                text-transform: uppercase;
            }

        .table tbody td {
            padding: 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text);
            vertical-align: middle;
        }

        .table tbody tr {
            transition: .25s ease;
        }

            .table tbody tr:nth-child(even) {
                background: rgba(148,163,184,.03);
            }

    [data-bs-theme="dark"] .table tbody tr:nth-child(even) {
        background: rgba(255,255,255,.02);
    }

    .table tbody tr:hover {
        background: var(--hover);
    }

    .table tbody tr:last-child td {
        border-bottom: none;
    }

    /* ==================================================
       BADGES
    ================================================== */

    .badge-success {
        background: rgba(16,185,129,.15);
        color: var(--success);
        border: 1px solid rgba(16,185,129,.25);
        padding: 8px 15px;
        border-radius: 30px;
        font-weight: 700;
    }

    .badge-danger {
        background: rgba(239,68,68,.15);
        color: var(--danger);
        border: 1px solid rgba(239,68,68,.25);
        padding: 8px 15px;
        border-radius: 30px;
        font-weight: 700;
    }

    .badge-warning {
        background: rgba(245,158,11,.15);
        color: var(--warning);
        border: 1px solid rgba(245,158,11,.25);
        padding: 8px 15px;
        border-radius: 30px;
        font-weight: 700;
    }

    /* ==================================================
       REVIEW SUMMARY
    ================================================== */

    .summary {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 20px;
    }

        .summary p {
            background: var(--card2);
            color: var(--text);
            border: 1px solid var(--border);
            padding: 14px 18px;
            border-radius: 14px;
            font-weight: 600;
        }

        .summary b {
            color: var(--primary);
        }

    /* ==================================================
       CHARTS
    ================================================== */

    .chart-card {
        min-height: 450px;
    }

        .chart-card canvas {
            width: 100% !important;
            height: 350px !important;
        }

    /* ==================================================
       EMPTY DATA
    ================================================== */

    .empty-text {
        text-align: center;
        padding: 40px;
        color: var(--muted);
    }

    /* ==================================================
       SCROLLBAR
    ================================================== */

    ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
    }

    ::-webkit-scrollbar-track {
        background: var(--card2);
    }

    ::-webkit-scrollbar-thumb {
        background: linear-gradient( 180deg, var(--primary), var(--primary2) );
        border-radius: 20px;
    }

    /* ==================================================
       BUTTONS
    ================================================== */

    .btn-primary {
        background: linear-gradient( 135deg, var(--primary), var(--primary2) );
        border: none;
    }

        .btn-primary:hover {
            opacity: .95;
        }

    /* ==================================================
       LINKS
    ================================================== */

    a {
        text-decoration: none;
    }

        a:hover {
            text-decoration: none;
        }

    /* ==================================================
       RESPONSIVE
    ================================================== */

    @@media(max - width:992px) {

        .content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media(max - width:768px) {

        .reports-page {
            padding: 20px;
        }

        .page-title {
            font-size: 28px;
        }

        .card-title {
            font-size: 20px;
        }

        .stat-value {
            font-size: 32px;
        }

        .summary p {
            width: 100%;
        }

        .table {
            min-width: 700px;
        }
    }
</style>

<div class="reports-page">

    <div class="page-title">
        <i class="fa-solid fa-chart-column"></i>
        Reports & Analytics
    </div>

    <div class="page-subtitle">
        Real-time library statistics and reports
    </div>

    <!-- STATS -->

    <div class="stats-grid">

        <div class="stat-card card-1">
            <div class="stat-icon">
                <i class="fa-solid fa-book"></i>
            </div>

            <div class="stat-title">
                Total Books
            </div>

            <div class="stat-value">
                @Model.TotalBooks
            </div>
        </div>

        <div class="stat-card card-2">
            <div class="stat-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div class="stat-title">
                Total Users
            </div>

            <div class="stat-value">
                @Model.TotalUsers
            </div>
        </div>

        <div class="stat-card card-3">
            <div class="stat-icon">
                <i class="fa-solid fa-book-open-reader"></i>
            </div>

            <div class="stat-title">
                Issued Books
            </div>

            <div class="stat-value">
                @Model.TotalIssuedBooks
            </div>
        </div>

        <div class="stat-card card-4">
            <div class="stat-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div class="stat-title">
                Overdue Books
            </div>

            <div class="stat-value">
                @Model.TotalOverdueBooks
            </div>
        </div>

    </div>

    <!-- CHARTS -->

    <div class="content-grid">

        <div class="chart-card">
            <div class="card-title">
                📈 Borrow Trend
            </div>

            <canvas id="borrowChart"></canvas>
        </div>

        <div class="chart-card">
            <div class="card-title">
                📚 Category Split
            </div>

            <canvas id="categoryChart"></canvas>
        </div>

    </div>


    <!-- MOST BORROWED -->

    <div class="report-card mb-4">

        <div class="card-title">
            🔥 Most Borrowed Books
        </div>

        @if (Model.MostBorrowedBooks.Any())
        {
            <table class="table table-dark table-borderless align-middle">

                <thead>
                    <tr>
                        <th>Book Name</th>
                        <th>Total Borrowed</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.MostBorrowedBooks)
                    {
                        <tr>
                            <td>@item.BookName</td>

                            <td>
                                <span class="badge-success">
                                    @item.BorrowCount Times
                                </span>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-text">
                No data available
            </div>
        }

    </div>

    <!-- ISSUED + RETURNED -->

    <div class="content-grid">

        <div class="report-card">

            <div class="card-title">
                📖 Issued Books
            </div>

            @if (Model.IssuedBooks.Any())
            {
                <table class="table table-dark table-borderless">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Issued Date</th>
                            <th>Due Date</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.IssuedBooks)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>
                                <td>@item.IssuedOn.ToString("dd MMM yyyy")</td>
                                <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-text">
                    No issued books
                </div>
            }

        </div>

        <div class="report-card">

            <div class="card-title">
                ✅ Returned Books
            </div>

            @if (Model.ReturnedBooks.Any())
            {
                <table class="table table-dark table-borderless">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Returned On</th>
                            <th>Fine</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.ReturnedBooks)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>
                                <td>@item.ReturnedOn.ToString("dd MMM yyyy")</td>

                                <td>
                                    ₹@item.FineAmount
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-text">
                    No returned books
                </div>
            }

        </div>

    </div>

    <!-- PENDING + LATE -->

    <div class="content-grid">

        <div class="report-card">

            <div class="card-title">
                ⏳ Pending Reservations
            </div>

            @if (Model.PendingReservations.Any())
            {
                <table class="table table-dark table-borderless">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Reserved On</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.PendingReservations)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>
                                <td>@item.ReservedOn.ToString("dd MMM yyyy")</td>
                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-text">
                    No pending reservations
                </div>
            }

        </div>

        <div class="report-card">

            <div class="card-title">
                🚨 Late Returns
            </div>

            @if (Model.LateReturns.Any())
            {
                <table class="table table-dark table-borderless">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Late Days</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.LateReturns)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>

                                <td>
                                    <span class="badge-danger">
                                        @item.LateDays Days
                                    </span>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-text">
                    No late returns
                </div>
            }

        </div>

    </div>


    <div class="report-card mb-4">

        <div class="card-title">
            ⭐ Reviews & Ratings
        </div>

        <div class="summary">
            <p><b>Total Reviews:</b> @Model.TotalReviews</p>
            <p><b>Average Rating:</b> @Model.AverageRating.ToString("0.0")</p>
        </div>

        @if (Model.BookReviews != null && Model.BookReviews.Any())
        {
            @* <table class="table table-dark table-borderless align-middle">

                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Member</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.BookReviews)
                    {
                        <tr>
                            <td>@item.BookName</td>
                            <td>@item.MemberName</td>

                            <td>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.Rating)
                                    {
                                        <i class="fa-solid fa-star text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star text-secondary"></i>
                                    }
                                }
                            </td>

                            <td>@item.Comment</td>

                            <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>

            </table> *@
        }
        else
        {
            @* <div class="empty-text">
                No reviews available
            </div> *@
        }

    </div>


</div>

<script>

    // BORROW CHART

    new Chart(document.getElementById('borrowChart'), {
    type: 'line',
    data: {
    labels: @Html.Raw(Json.Serialize(Model.BorrowChartLabels)),
    datasets: [{
    label: 'Borrowed Books',
    data: @Html.Raw(Json.Serialize(Model.BorrowChartData)),
    borderWidth: 3,
    tension: .4
    }]
    }
    });

    // CATEGORY CHART

    new Chart(document.getElementById('categoryChart'), {
    type: 'doughnut',
    data: {
    labels: @Html.Raw(Json.Serialize(Model.CategoryLabels)),
    datasets: [{
    data: @Html.Raw(Json.Serialize(Model.CategoryData)),
    borderWidth: 1
    }]
    }
    });

    new Chart(document.getElementById('ratingChart'), {
    type: 'bar',
    data: {
    labels: @Html.Raw(Json.Serialize(Model.RatingLabels)),
    datasets: [{
    label: 'Reviews',
    data: @Html.Raw(Json.Serialize(Model.RatingCounts))
    }]
    }
    });
</script>
