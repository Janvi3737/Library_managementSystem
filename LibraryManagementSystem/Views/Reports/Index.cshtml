@model LibraryManagementSystem.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Reports & Analytics";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    /* =========================
       LIGHT MODE
    ========================= */

    :root {
        --bg: #f8fafc;
        --card: #ffffff;
        --card2: #f1f5f9;
        --text: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
        --primary: #6366f1;
        --primary2: #8b5cf6;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --shadow: 0 12px 30px rgba(15,23,42,.08);
    }

    /* =========================
       DARK MODE
    ========================= */

    [data-bs-theme="dark"] {
        --bg: #0f172a;
        --card: #111827;
        --card2: #1e293b;
        --text: #f8fafc;
        --muted: #94a3b8;
        --border: rgba(255,255,255,.08);
        --primary: #818cf8;
        --primary2: #a78bfa;
        --success: #34d399;
        --danger: #f87171;
        --warning: #fbbf24;
        --shadow: 0 12px 35px rgba(0,0,0,.35);
    }

    /* =========================
       BODY
    ========================= */

    body {
        background: var(--bg);
        font-family: 'Inter', sans-serif;
        color: var(--text);
    }

    /* =========================
       PAGE
    ========================= */

    .reports-page {
        padding: 35px;
    }

    .page-title {
        font-size: 38px;
        font-weight: 800;
        margin-bottom: 10px;
        color: var(--text);
    }

    .page-subtitle {
        color: var(--muted);
        margin-bottom: 35px;
        font-size: 15px;
    }

    /* =========================
       STATS
    ========================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
        gap: 24px;
        margin-bottom: 35px;
    }

    .stat-card {
        border-radius: 24px;
        padding: 28px;
        position: relative;
        overflow: hidden;
        color: white;
        box-shadow: var(--shadow);
        transition: .3s ease;
    }

        .stat-card:hover {
            transform: translateY(-6px);
        }

    .card-1 {
        background: linear-gradient(135deg,#4f46e5,#7c3aed);
    }

    .card-2 {
        background: linear-gradient(135deg,#0891b2,#06b6d4);
    }

    .card-3 {
        background: linear-gradient(135deg,#059669,#10b981);
    }

    .card-4 {
        background: linear-gradient(135deg,#dc2626,#f43f5e);
    }

    .stat-icon {
        font-size: 34px;
        margin-bottom: 18px;
        opacity: .95;
    }

    .stat-title {
        font-size: 15px;
        color: rgba(255,255,255,.9);
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 40px;
        font-weight: 800;
    }

    /* =========================
       CONTENT GRID
    ========================= */

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-bottom: 30px;
    }

    /* =========================
       REPORT CARDS
    ========================= */

    .report-card,
    .chart-card {
        background: var(--card);
        border-radius: 24px;
        padding: 25px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    .card-title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 24px;
        color: var(--text);
    }

    /* =========================
       TABLES
    ========================= */

    .table {
        margin-bottom: 0;
    }

    table {
        width: 100%;
    }

    thead {
        background: var(--card2);
    }

    th {
        padding: 16px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 700;
        border: none !important;
    }

    td {
        padding: 16px;
        color: var(--text);
        font-size: 14px;
        border-bottom: 1px solid var(--border);
    }

    tbody tr {
        transition: .2s ease;
    }

        tbody tr:hover {
            background: rgba(99,102,241,.05);
        }

    /* =========================
       BADGES
    ========================= */

    .badge-success {
        background: rgba(16,185,129,.15);
        color: var(--success);
        padding: 8px 14px;
        border-radius: 30px;
        font-weight: 700;
    }

    .badge-danger {
        background: rgba(239,68,68,.15);
        color: var(--danger);
        padding: 8px 14px;
        border-radius: 30px;
        font-weight: 700;
    }

    /* =========================
       REVIEW SUMMARY
    ========================= */

    .summary {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

        .summary p {
            margin: 0;
            background: var(--card2);
            padding: 12px 18px;
            border-radius: 14px;
            color: var(--text);
            border: 1px solid var(--border);
            font-weight: 600;
        }

        .summary b {
            color: var(--primary);
        }

    /* =========================
       EMPTY TEXT
    ========================= */

    .empty-text {
        color: var(--muted);
        text-align: center;
        padding: 35px;
        font-size: 15px;
    }

    /* =========================
       CHARTS
    ========================= */

    canvas {
        width: 100% !important;
        height: 340px !important;
    }

    /* =========================
       SCROLLBAR
    ========================= */

    ::-webkit-scrollbar {
        width: 10px;
        height: 10px;
    }

    ::-webkit-scrollbar-thumb {
        background: var(--primary);
        border-radius: 20px;
    }

    ::-webkit-scrollbar-track {
        background: var(--card2);
    }

    /* =========================
       RESPONSIVE
    ========================= */

    @@media(max - width:992px) {

        .content-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media(max - width:768px) {

        .reports-page {
            padding: 18px;
        }

        .page-title {
            font-size: 28px;
        }

        .stat-value {
            font-size: 30px;
        }

        .card-title {
            font-size: 20px;
        }

        table {
            display: block;
            overflow-x: auto;
            white-space: nowrap;
        }
    }

    /* ========================================
       PREMIUM REPORTS UI
    ======================================== */

    /* CARD EFFECT */

    .report-card,
    .chart-card,
    .stat-card {
        position: relative;
    }

        .report-card::before,
        .chart-card::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 24px;
            padding: 1px;
            background: linear-gradient( 135deg, rgba(99,102,241,.25), rgba(139,92,246,.15) );
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            pointer-events: none;
        }

    /* STAT CARDS */

    .stat-card {
        min-height: 170px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .stat-card::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -70px;
            top: -70px;
            background: rgba(255,255,255,.08);
            border-radius: 50%;
        }

    .stat-value {
        line-height: 1;
        letter-spacing: -1px;
    }

    .stat-icon {
        opacity: .9;
    }

    /* TABLES */

    .table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead th:first-child {
            border-top-left-radius: 12px;
        }

        .table thead th:last-child {
            border-top-right-radius: 12px;
        }

        .table tbody tr {
            transition: all .25s ease;
        }

            .table tbody tr:hover {
                transform: scale(1.01);
            }

            /* TABLE ROW ALTERNATE */

            .table tbody tr:nth-child(even) {
                background: rgba(148,163,184,.03);
            }

    /* REVIEW STARS */

    .fa-star {
        font-size: 15px;
    }

    .text-warning {
        color: #fbbf24 !important;
    }

    /* CHART CONTAINER */

    .chart-card {
        min-height: 450px;
    }

        .chart-card canvas {
            margin-top: 10px;
        }

    /* SECTION TITLES */

    .card-title {
        display: flex;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid var(--border);
        padding-bottom: 15px;
    }

    /* REVIEW SUMMARY */

    .summary {
        margin-bottom: 25px;
    }

        .summary p {
            min-width: 220px;
            box-shadow: 0 4px 15px rgba(0,0,0,.06);
        }

            .summary p:nth-child(1) {
                border-left: 4px solid #6366f1;
            }

            .summary p:nth-child(2) {
                border-left: 4px solid #f59e0b;
            }

    /* BADGES */

    .badge-success,
    .badge-danger {
        min-width: 110px;
        display: inline-block;
        text-align: center;
    }

    /* EMPTY STATES */

    .empty-text {
        padding: 50px;
        font-size: 15px;
    }

        .empty-text::before {
            display: block;
            font-size: 40px;
            margin-bottom: 10px;
        }

    /* PAGE TITLE */

    .page-title {
        display: flex;
        align-items: center;
        gap: 15px;
        color: var(--text);
    }

        .page-title i {
            color: #6366f1;
        }

    /* SUBTITLE */

    .page-subtitle {
        font-size: 15px;
        max-width: 700px;
    }

    /* CONTENT GRID */

    .content-grid {
        align-items: start;
    }

    /* REPORT CARD HOVER */

    .report-card:hover,
    .chart-card:hover {
        transform: translateY(-3px);
        transition: .3s ease;
    }

    /* CHART CARD GLOW */

    .chart-card:hover {
        box-shadow: 0 15px 40px rgba(99,102,241,.12);
    }

    /* TABLE HEADER */

    thead {
        background: linear-gradient( 90deg, var(--card2), rgba(99,102,241,.05) );
    }

    /* MOBILE */

    @@media (max-width:768px) {

        .summary p {
            width: 100%;
        }

        .stat-card {
            min-height: 140px;
        }

        .card-title {
            font-size: 18px;
        }

        .report-card,
        .chart-card {
            padding: 18px;
        }

        .table tbody tr:hover {
            transform: none;
        }
    }
</style>

<div class="reports-page">

    <div class="page-title">
        <i class="fa-solid fa-chart-column"></i>
        Reports & Analytics
    </div>

    <div class="page-subtitle">
        Real-time library statistics and reports
    </div>

    <!-- STATS -->

    <div class="stats-grid">

        <div class="stat-card card-1">
            <div class="stat-icon">
                <i class="fa-solid fa-book"></i>
            </div>

            <div class="stat-title">
                Total Books
            </div>

            <div class="stat-value">
                @Model.TotalBooks
            </div>
        </div>

        <div class="stat-card card-2">
            <div class="stat-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div class="stat-title">
                Total Users
            </div>

            <div class="stat-value">
                @Model.TotalUsers
            </div>
        </div>

        <div class="stat-card card-3">
            <div class="stat-icon">
                <i class="fa-solid fa-book-open-reader"></i>
            </div>

            <div class="stat-title">
                Issued Books
            </div>

            <div class="stat-value">
                @Model.TotalIssuedBooks
            </div>
        </div>

        <div class="stat-card card-4">
            <div class="stat-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div class="stat-title">
                Overdue Books
            </div>

            <div class="stat-value">
                @Model.TotalOverdueBooks
            </div>
        </div>

    </div>

    <!-- CHARTS -->

    <div class="content-grid">

        <div class="chart-card">
            <div class="card-title">
                📈 Borrow Trend
            </div>

            <canvas id="borrowChart"></canvas>
        </div>

        <div class="chart-card">
            <div class="card-title">
                📚 Category Split
            </div>

            <canvas id="categoryChart"></canvas>
        </div>

    </div>


    <!-- MOST BORROWED -->

    <div class="report-card mb-4">

        <div class="card-title">
            🔥 Most Borrowed Books
        </div>

        @if (Model.MostBorrowedBooks.Any())
        {
            <table class="table table-dark table-borderless align-middle">

                <thead>
                    <tr>
                        <th>Book Name</th>
                        <th>Total Borrowed</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.MostBorrowedBooks)
                    {
                        <tr>
                            <td>@item.BookName</td>

                            <td>
                                <span class="badge-success">
                                    @item.BorrowCount Times
                                </span>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-text">
                No data available
            </div>
        }

    </div>

    <!-- ISSUED + RETURNED -->

    <div class="content-grid">

        <div class="report-card">

            <div class="card-title">
                📖 Issued Books
            </div>

            @if (Model.IssuedBooks.Any())
            {
                <table class="table table-dark table-borderless">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Issued Date</th>
                            <th>Due Date</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.IssuedBooks)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>
                                <td>@item.IssuedOn.ToString("dd MMM yyyy")</td>
                                <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-text">
                    No issued books
                </div>
            }

        </div>

        <div class="report-card">

            <div class="card-title">
                ✅ Returned Books
            </div>

            @if (Model.ReturnedBooks.Any())
            {
                <table class="table table-dark table-borderless">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Returned On</th>
                            <th>Fine</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.ReturnedBooks)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>
                                <td>@item.ReturnedOn.ToString("dd MMM yyyy")</td>

                                <td>
                                    ₹@item.FineAmount
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-text">
                    No returned books
                </div>
            }

        </div>

    </div>

    <!-- PENDING + LATE -->

    <div class="content-grid">

        <div class="report-card">

            <div class="card-title">
                ⏳ Pending Reservations
            </div>

            @if (Model.PendingReservations.Any())
            {
                <table class="table table-dark table-borderless">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Reserved On</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.PendingReservations)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>
                                <td>@item.ReservedOn.ToString("dd MMM yyyy")</td>
                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-text">
                    No pending reservations
                </div>
            }

        </div>

        <div class="report-card">

            <div class="card-title">
                🚨 Late Returns
            </div>

            @if (Model.LateReturns.Any())
            {
                <table class="table table-dark table-borderless">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Late Days</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.LateReturns)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>

                                <td>
                                    <span class="badge-danger">
                                        @item.LateDays Days
                                    </span>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-text">
                    No late returns
                </div>
            }

        </div>

    </div>


    <div class="report-card mb-4">

        <div class="card-title">
            ⭐ Reviews & Ratings
        </div>

        <div class="summary">
            <p><b>Total Reviews:</b> @Model.TotalReviews</p>
            <p><b>Average Rating:</b> @Model.AverageRating.ToString("0.0")</p>
        </div>

        @if (Model.BookReviews != null && Model.BookReviews.Any())
        {
            @* <table class="table table-dark table-borderless align-middle">

                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Member</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.BookReviews)
                    {
                        <tr>
                            <td>@item.BookName</td>
                            <td>@item.MemberName</td>

                            <td>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.Rating)
                                    {
                                        <i class="fa-solid fa-star text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star text-secondary"></i>
                                    }
                                }
                            </td>

                            <td>@item.Comment</td>

                            <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>

            </table> *@
        }
        else
        {
            @* <div class="empty-text">
                No reviews available
            </div> *@
        }

    </div>


</div>

<script>

    // BORROW CHART

    new Chart(document.getElementById('borrowChart'), {
    type: 'line',
    data: {
    labels: @Html.Raw(Json.Serialize(Model.BorrowChartLabels)),
    datasets: [{
    label: 'Borrowed Books',
    data: @Html.Raw(Json.Serialize(Model.BorrowChartData)),
    borderWidth: 3,
    tension: .4
    }]
    }
    });

    // CATEGORY CHART

    new Chart(document.getElementById('categoryChart'), {
    type: 'doughnut',
    data: {
    labels: @Html.Raw(Json.Serialize(Model.CategoryLabels)),
    datasets: [{
    data: @Html.Raw(Json.Serialize(Model.CategoryData)),
    borderWidth: 1
    }]
    }
    });

    new Chart(document.getElementById('ratingChart'), {
    type: 'bar',
    data: {
    labels: @Html.Raw(Json.Serialize(Model.RatingLabels)),
    datasets: [{
    label: 'Reviews',
    data: @Html.Raw(Json.Serialize(Model.RatingCounts))
    }]
    }
    });
</script>
