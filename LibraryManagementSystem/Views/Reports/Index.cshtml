@model LibraryManagementSystem.ViewModels.ReportViewModel

@{
    ViewData["Title"] = "Reports & Analytics";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

    * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    }

    :root {
    --bg: #f8fafc;
    --card: #ffffff;
    --card2: #f1f5f9;
    --text: #0f172a;
    --muted: #64748b;
    --border: #e2e8f0;
    --primary: #6366f1;
    --success: #10b981;
    --danger: #ef4444;
    --shadow: 0 12px 30px rgba(15, 23, 42, .08);
    }

    [data-bs-theme="dark"] {
    --bg: #0f172a;
    --card: #111827;
    --card2: #1e293b;
    --text: #f8fafc;
    --muted: #94a3b8;
    --border: rgba(255, 255, 255, .08);
    }

    body {
    background: var(--bg);
    font-family: 'Inter', sans-serif;
    color: var(--text);
    }

    .reports-page {
    padding: 35px;
    }

    .page-title {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 38px;
    font-weight: 800;
    margin-bottom: 10px;
    }

    .page-title i {
    color: var(--primary);
    }

    .page-subtitle {
    color: var(--muted);
    margin-bottom: 35px;
    font-size: 15px;
    }
    /* =========================================
   PREMIUM TABLE DESIGN
========================================= */

.table-responsive {
    overflow-x: auto;
    border-radius: 22px;
}

.custom-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border-radius: 22px;
    background: #ffffff;
}

[data-bs-theme="dark"] .custom-table {
    background: #111827;
}

/* TABLE HEADER */

.custom-table thead {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
}

.custom-table thead th {
    padding: 22px 24px;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    border: none;
    white-space: nowrap;
    letter-spacing: .3px;
}

.custom-table thead th:first-child {
    border-top-left-radius: 20px;
}

.custom-table thead th:last-child {
    border-top-right-radius: 20px;
}

/* TABLE BODY */

.custom-table tbody tr {
    transition: all .25s ease;
}

.custom-table tbody tr:nth-child(even) {
    background: #f8fafc;
}

[data-bs-theme="dark"] .custom-table tbody tr:nth-child(even) {
    background: rgba(255,255,255,.03);
}

.custom-table tbody tr:hover {
    background: rgba(99,102,241,.08);
    transform: scale(1.002);
}

.custom-table tbody td {
    padding: 26px 24px;
    border-bottom: 1px solid #edf2f7;
    color: #0f172a;
    font-size: 16px;
    font-weight: 600;
    vertical-align: middle;
    line-height: 1.7;
}

[data-bs-theme="dark"] .custom-table tbody td {
    color: #f8fafc;
    border-bottom: 1px solid rgba(255,255,255,.05);
}

/* LAST ROW */

.custom-table tbody tr:last-child td:first-child {
    border-bottom-left-radius: 20px;
}

.custom-table tbody tr:last-child td:last-child {
    border-bottom-right-radius: 20px;
}

/* BADGES */

.badge-success {
    background: rgba(16,185,129,.12);
    color: #059669;
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    min-width: 120px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.badge-danger {
    background: rgba(239,68,68,.12);
    color: #dc2626;
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    min-width: 120px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

/* REVIEW STARS */

.fa-star {
    margin-right: 2px;
    font-size: 15px;
}

/* MOBILE */

@@media(max-width:768px) {

    .custom-table thead th {
        padding: 16px;
        font-size: 13px;
    }

    .custom-table tbody td {
        padding: 18px 16px;
        font-size: 14px;
    }

    .badge-success,
    .badge-danger {
        min-width: auto;
        padding: 10px 14px;
        font-size: 12px;
    }
}

    /* =========================
    STATS
    ========================= */

    .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin-bottom: 35px;
    }

    .stat-card {
    border-radius: 24px;
    padding: 28px;
    color: white;
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: .3s ease;
    }

    .stat-card:hover {
    transform: translateY(-6px);
    }

    .card-1 {
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    }

    .card-2 {
    background: linear-gradient(135deg, #0891b2, #06b6d4);
    }

    .card-3 {
    background: linear-gradient(135deg, #059669, #10b981);
    }

    .card-4 {
    background: linear-gradient(135deg, #dc2626, #f43f5e);
    }

    .stat-icon {
    font-size: 34px;
    margin-bottom: 18px;
    }

    .stat-title {
    font-size: 15px;
    margin-bottom: 10px;
    opacity: .9;
    }

    .stat-value {
    font-size: 40px;
    font-weight: 800;
    }

    /* =========================
    GRID
    ========================= */

    .content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-bottom: 30px;
    }

    /* =========================
    CARDS
    ========================= */

    .report-card,
    .chart-card {
    background: var(--card);
    border-radius: 26px;
    padding: 28px;
    border: 1px solid rgba(99, 102, 241, .12);
    box-shadow:
    0 10px 35px rgba(15, 23, 42, .06),
    0 2px 8px rgba(15, 23, 42, .04);
    overflow: hidden;
    transition: .3s ease;
    }

    .report-card:hover,
    .chart-card:hover {
    transform: translateY(-4px);
    }

    .card-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 24px;
    font-weight: 800;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
    }

    /* =========================
    TABLES
    ========================= */

    .table-responsive {
    overflow-x: auto;
    border-radius: 18px;
    }

    .custom-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    overflow: hidden;
    border-radius: 18px;
    background: white;
    }

    [data-bs-theme="dark"] .custom-table {
    background: #111827;
    }

    .custom-table thead {
    background: linear-gradient(135deg, #1e293b, #111827);
    }

    .custom-table thead th {
    padding: 18px 20px;
    color: white;
    font-size: 14px;
    font-weight: 700;
    border: none;
    white-space: nowrap;
    }

    .custom-table tbody tr {
    transition: .25s ease;
    }

    .custom-table tbody tr:nth-child(even) {
    background: rgba(99, 102, 241, .03);
    }

    .custom-table tbody tr:hover {
    background: rgba(99, 102, 241, .08);
    }

    .custom-table td {
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 15px;
    font-weight: 500;
    vertical-align: middle;
    }

    /* =========================
    BADGES
    ========================= */

    .badge-success {
    background: rgba(16, 185, 129, .15);
    color: #059669;
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    min-width: 110px;
    display: inline-flex;
    justify-content: center;
    }

    .badge-danger {
    background: rgba(239, 68, 68, .15);
    color: #dc2626;
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    min-width: 110px;
    display: inline-flex;
    justify-content: center;
    }

    /* =========================
    SUMMARY
    ========================= */

    .summary {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    }

    .summary p {
    margin: 0;
    background: var(--card2);
    padding: 14px 18px;
    border-radius: 14px;
    border: 1px solid var(--border);
    font-weight: 600;
    }

    .summary b {
    color: var(--primary);
    }

    /* =========================
    EMPTY
    ========================= */

    .empty-text {
    text-align: center;
    padding: 50px;
    color: var(--muted);
    }

    /* =========================
    CHARTS
    ========================= */

    canvas {
    width: 100% !important;
    height: 340px !important;
    }

    /* =========================
    MOBILE
    ========================= */

    @@media(max-width:992px) {

    .content-grid {
    grid-template-columns: 1fr;
    }
    }

    @@media(max-width:768px) {

    .reports-page {
    padding: 18px;
    }

    .page-title {
    font-size: 28px;
    }

    .report-card,
    .chart-card {
    padding: 18px;
    }

    .card-title {
    font-size: 20px;
    }

    .custom-table th,
    .custom-table td {
    padding: 14px;
    font-size: 14px;
    }

    .summary p {
    width: 100%;
    }
    }
</style>

<div class="reports-page">

    <div class="page-title">
        <i class="fa-solid fa-chart-column"></i>
        Reports & Analytics
    </div>

    <div class="page-subtitle">
        Real-time library statistics and reports
    </div>

    <!-- STATS -->

    <div class="stats-grid">

        <div class="stat-card card-1">
            <div class="stat-icon">
                <i class="fa-solid fa-book"></i>
            </div>

            <div class="stat-title">
                Total Books
            </div>

            <div class="stat-value">
                @Model.TotalBooks
            </div>
        </div>

        <div class="stat-card card-2">
            <div class="stat-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div class="stat-title">
                Total Users
            </div>

            <div class="stat-value">
                @Model.TotalUsers
            </div>
        </div>

        <div class="stat-card card-3">
            <div class="stat-icon">
                <i class="fa-solid fa-book-open-reader"></i>
            </div>

            <div class="stat-title">
                Issued Books
            </div>

            <div class="stat-value">
                @Model.TotalIssuedBooks
            </div>
        </div>

        <div class="stat-card card-4">
            <div class="stat-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div class="stat-title">
                Overdue Books
            </div>

            <div class="stat-value">
                @Model.TotalOverdueBooks
            </div>
        </div>

    </div>

    <!-- CHARTS -->

    <div class="content-grid">

        <div class="chart-card">
            <div class="card-title">
                📈 Borrow Trend
            </div>

            <canvas id="borrowChart"></canvas>
        </div>

        <div class="chart-card">
            <div class="card-title">
                📚 Category Split
            </div>

            <canvas id="categoryChart"></canvas>
        </div>

    </div>

    <!-- MOST BORROWED -->

    <div class="report-card mb-4">

        <div class="card-title">
            🔥 Most Borrowed Books
        </div>

        @if (Model.MostBorrowedBooks.Any())
        {
            <div class="table-responsive">

                <table class="custom-table">

                    <thead>
                        <tr>
                            <th>Book Name</th>
                            <th>Total Borrowed</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.MostBorrowedBooks)
                        {
                            <tr>
                                <td>@item.BookName</td>

                                <td>
                                    <span class="badge-success">
                                        @item.BorrowCount Times
                                    </span>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-text">
                No data available
            </div>
        }

    </div>


    <!-- ISSUED + RETURNED -->

    <div class="content-grid">

        <div class="report-card">

            <div class="card-title">
                📖 Issued Books
            </div>

            @if (Model.IssuedBooks.Any())
            {
                <div class="table-responsive">
                    <table class="custom-table">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Issued Date</th>
                            <th>Due Date</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.IssuedBooks)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>
                                <td>@item.IssuedOn.ToString("dd MMM yyyy")</td>
                                <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }

                    </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="empty-text">
                    No issued books
                </div>
            }

        </div>

        <div class="report-card">

            <div class="card-title">
                ✅ Returned Books
            </div>

            @if (Model.ReturnedBooks.Any())
            {
                <div class="table-responsive">
                    <table class="custom-table">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Returned On</th>
                            <th>Fine</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.ReturnedBooks)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>
                                <td>@item.ReturnedOn.ToString("dd MMM yyyy")</td>

                                <td>
                                    ₹@item.FineAmount
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
                </div>
            }
            else
            {
                <div class="empty-text">
                    No returned books
                </div>
            }

        </div>

    </div>

    <!-- PENDING + LATE -->

    <div class="content-grid">

        <div class="report-card">

            <div class="card-title">
                ⏳ Pending Reservations
            </div>

            @if (Model.PendingReservations.Any())
            {
                <div class="table-responsive">
                    <table class="custom-table">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Reserved On</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.PendingReservations)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>
                                <td>@item.ReservedOn.ToString("dd MMM yyyy")</td>
                            </tr>
                        }

                    </tbody>

                </table>
                </div>
            }
            else
            {
                <div class="empty-text">
                    No pending reservations
                </div>
            }

        </div>

        <div class="report-card">

            <div class="card-title">
                🚨 Late Returns
            </div>

            @if (Model.LateReturns.Any())
            {
               <div class="table-responsive">
    <table class="custom-table">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Member</th>
                            <th>Late Days</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.LateReturns)
                        {
                            <tr>
                                <td>@item.BookName</td>
                                <td>@item.MemberName</td>

                                <td>
                                    <span class="badge-danger">
                                        @item.LateDays Days
                                    </span>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
               </div>
            }
            else
            {
                <div class="empty-text">
                    No late returns
                </div>
            }

        </div>

    </div>


    <div class="report-card mb-4">

        <div class="card-title">
            ⭐ Reviews & Ratings
        </div>

        <div class="summary">
            <p><b>Total Reviews:</b> @Model.TotalReviews</p>
            <p><b>Average Rating:</b> @Model.AverageRating.ToString("0.0")</p>
        </div>

        @if (Model.BookReviews != null && Model.BookReviews.Any())
        {
            <div class="table-responsive">
                <table class="custom-table">

                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Member</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Date</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.BookReviews)
                    {
                        <tr>
                            <td>@item.BookName</td>
                            <td>@item.MemberName</td>

                            <td>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= item.Rating)
                                    {
                                        <i class="fa-solid fa-star text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star text-secondary"></i>
                                    }
                                }
                            </td>

                            <td>@item.Comment</td>

                            <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>

            </table>
            </div>
        }
        else
        {
             <div class="empty-text">
No reviews available
</div> 
        }

    </div>


</div>

</div>

<script>

    new Chart(document.getElementById('borrowChart'), {
    type: 'line',
    data: {
    labels: @Html.Raw(Json.Serialize(Model.BorrowChartLabels)),
    datasets: [{
    label: 'Borrowed Books',
    data: @Html.Raw(Json.Serialize(Model.BorrowChartData)),
    borderWidth: 3,
    tension: .4
    }]
    }
    });

    new Chart(document.getElementById('categoryChart'), {
    type: 'doughnut',
    data: {
    labels: @Html.Raw(Json.Serialize(Model.CategoryLabels)),
    datasets: [{
    data: @Html.Raw(Json.Serialize(Model.CategoryData)),
    borderWidth: 1
    }]
    }
    });

    new Chart(document.getElementById('ratingChart'), {
    type: 'bar',
    data: {
    labels: @Html.Raw(Json.Serialize(Model.RatingLabels)),
    datasets: [{
    label: 'Reviews',
    data: @Html.Raw(Json.Serialize(Model.RatingCounts))
    }]
    }
    });
</script>
