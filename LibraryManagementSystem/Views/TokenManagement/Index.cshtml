@model IEnumerable<LibraryManagementSystem.ClassLibrary.Models.TokenPayment>

@{
    ViewData["Title"] = "Token Approval Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

    :root {
        --bg: #f5f5f5;
        --card: #ffffff;
        --card-hover: #fafafa;
        --text: #111111;
        --text-light: #666666;
        --border: #e5e5e5;
        --shadow: 0 15px 40px rgba(0,0,0,.08);
        --shadow-hover: 0 25px 60px rgba(0,0,0,.12);
        --radius: 24px;
    }

    /* ===================================
           GLOBAL
        =================================== */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: radial-gradient(circle at top left, rgba(0,0,0,.05), transparent 25%), radial-gradient(circle at bottom right, rgba(0,0,0,.04), transparent 25%), var(--bg);
        font-family: 'Inter', sans-serif;
        color: var(--text);
    }

    /* ===================================
           PAGE
        =================================== */

    .page {
        padding: 35px;
        max-width: 1600px;
        margin: auto;
    }

    /* ===================================
           HEADER
        =================================== */

    .header {
        background: #fff;
        border-radius: 28px;
        padding: 30px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

        .header h2 {
            font-size: 34px;
            font-weight: 900;
            letter-spacing: -.5px;
        }

    .sub {
        margin-top: 8px;
        color: var(--text-light);
        font-size: 15px;
    }

    /* ===================================
           EMPTY STATE
        =================================== */

    .empty {
        margin-top: 25px;
        background: white;
        border-radius: 30px;
        border: 1px solid var(--border);
        padding: 80px 30px;
        text-align: center;
        box-shadow: var(--shadow);
    }

        .empty i {
            font-size: 70px;
            color: #bdbdbd;
        }

        .empty h3 {
            margin-top: 20px;
            font-weight: 800;
        }

        .empty p {
            margin-top: 10px;
            color: var(--text-light);
        }

    /* ===================================
           GRID
        =================================== */

    .grid {
        display: flex;
        flex-direction: column;
        gap: 25px;
        margin-top: 30px;
    }

    /* ===================================
           CARD
        =================================== */

    .card {
        background: var(--card);
        border-radius: 30px;
        border: 1px solid var(--border);
        padding: 24px;
        display: grid;
        grid-template-columns: 330px 1fr;
        gap: 28px;
        box-shadow: var(--shadow);
        transition: .35s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            background: var(--card-hover);
            box-shadow: var(--shadow-hover);
        }

    /* ===================================
           IMAGE
        =================================== */

    .image-section {
        position: relative;
    }

    .img {
        width: 100%;
        height: 290px;
        object-fit: cover;
        border-radius: 24px;
        border: 1px solid var(--border);
    }

    .no-image {
        height: 290px;
        border-radius: 24px;
        background: #fafafa;
        border: 2px dashed #d4d4d4;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 12px;
        color: #999;
    }

        .no-image i {
            font-size: 55px;
        }

    /* ===================================
           CONTENT
        =================================== */

    .content-section {
        display: flex;
        flex-direction: column;
    }

    .top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* ===================================
           USER
        =================================== */

    .user {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .avatar {
        width: 72px;
        height: 72px;
        border-radius: 22px;
        background: #111;
        color: white;
        font-size: 24px;
        font-weight: 900;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .name {
        font-size: 22px;
        font-weight: 800;
    }

    .email {
        margin-top: 4px;
        color: var(--text-light);
        font-size: 14px;
    }

    /* ===================================
           STATUS
        =================================== */

    .status {
        padding: 10px 18px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .pending {
        background: #fff7d6;
        color: #9a6700;
    }

    .approved {
        background: #ecfdf3;
        color: #166534;
    }

    .rejected {
        background: #fef2f2;
        color: #991b1b;
    }

    /* ===================================
           DETAILS
        =================================== */

    .details {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 16px;
        margin-top: 25px;
    }

    .row {
        background: #fafafa;
        border: 1px solid var(--border);
        padding: 18px;
        border-radius: 18px;
    }

    .label {
        font-size: 12px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: .7px;
        margin-bottom: 8px;
    }

    .value {
        font-size: 16px;
        font-weight: 800;
        color: #111;
    }

    /* ===================================
           BUTTONS
        =================================== */

    .actions {
        display: flex;
        gap: 16px;
        margin-top: auto;
        padding-top: 25px;
    }

        .actions form {
            flex: 1;
        }

    .btn-approve,
    .btn-reject {
        width: 100%;
        height: 56px;
        border: none;
        border-radius: 18px;
        font-size: 15px;
        font-weight: 800;
        cursor: pointer;
        transition: .3s;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
    }

    .btn-approve {
        background: #111;
        color: white;
    }

        .btn-approve:hover {
            background: #000;
            transform: translateY(-2px);
        }

    .btn-reject {
        background: white;
        color: #111;
        border: 2px solid #111;
    }

        .btn-reject:hover {
            background: #111;
            color: white;
            transform: translateY(-2px);
        }

    /* ===================================
           SCROLLBAR
        =================================== */

    ::-webkit-scrollbar {
        width: 10px;
    }

    ::-webkit-scrollbar-thumb {
        background: #111;
        border-radius: 999px;
    }

    ::-webkit-scrollbar-track {
        background: #eee;
    }

    /* ===================================
           RESPONSIVE
        =================================== */

    @@media (max-width: 992px) {

        .card {
            grid-template-columns: 1fr;
        }

        .details {
            grid-template-columns: 1fr;
        }

        .img,
        .no-image {
            height: 240px;
        }
    }

    @@media (max-width: 768px) {

        .page {
            padding: 15px;
        }

        .header {
            padding: 22px;
        }

            .header h2 {
                font-size: 26px;
            }

        .top {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }

        .actions {
            flex-direction: column;
        }

        .avatar {
            width: 60px;
            height: 60px;
        }

        .name {
            font-size: 18px;
        }
    }
</style>

<div class="page">

    <!-- HEADER -->
    <div class="header">
        <h2>
            <i class="bi bi-shield-check"></i>
            Token Approval Management
        </h2>
        <div class="sub">
            Review payment screenshots and approve token requests
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty">
            <i class="bi bi-coin fs-1"></i>
            <h3>No Token Requests</h3>
            <p>All token payments are processed.</p>
        </div>
    }
    else
    {
        <div class="grid">

            @foreach (var item in Model)
            {
                var name = item.UserToken?.User?.FullName ?? "User";
                var email = item.UserToken?.User?.Email ?? "-";
                var initial = name.Substring(0, 1).ToUpper();

                var availableTokens = item.UserToken?.AvailableTokens ?? 0;
                var usedTokens = item.UserToken?.TotalBorrowCount ?? 0;
                var totalPurchased = availableTokens + usedTokens;

                bool limitReached = totalPurchased >= 3;

                <div class="card">

                    <!-- IMAGE -->
                    <div class="image-section">

                        @if (!string.IsNullOrEmpty(item.ScreenshotPath))
                        {
                            <img src="@item.ScreenshotPath" class="img" />
                        }
                        else
                        {
                            <div class="no-image">
                                <i class="bi bi-image"></i>
                                <span>No Screenshot</span>
                            </div>
                        }

                    </div>

                    <!-- CONTENT -->
                    <div class="content-section">

                        <div class="top">

                            <div class="user">

                                <div class="avatar">
                                    @initial
                                </div>

                                <div>
                                    <div class="name">@name</div>
                                    <div class="email">@email</div>
                                </div>

                            </div>

                            <div class="status @(item.PaymentStatus == "Approved"
                                                             ? "approved"
                                                             : item.PaymentStatus == "Rejected"
                                                                 ? "rejected"
                                                                 : "pending")">

                                @item.PaymentStatus

                            </div>

                        </div>

                        <div class="details">

                            <div class="row">
                                <div class="label">Token</div>
                                <div class="value">1 Borrow Token</div>
                            </div>

                            <div class="row">
                                <div class="label">Amount</div>
                                <div class="value">₹@item.Amount</div>
                            </div>

                            <div class="row">
                                <div class="label">Method</div>
                                <div class="value">@item.PaymentMethod</div>
                            </div>

                            <div class="row">
                                <div class="label">Transaction ID</div>
                                <div class="value">@item.TransactionId</div>
                            </div>

                            <div class="row">
                                <div class="label">Date</div>
                                <div class="value">@item.PaymentDate.ToString("dd MMM yyyy")</div>
                            </div>

                            <hr />

                            <div class="row">
                                <div class="label">Available Tokens</div>
                                <div class="value">@availableTokens</div>
                            </div>

                            <div class="row">
                                <div class="label">Used Tokens</div>
                                <div class="value">@usedTokens</div>
                            </div>

                            <div class="row">
                                <div class="label">Total Purchased</div>
                                <div class="value">@totalPurchased / 3</div>
                            </div>

                        </div>

                        @if (item.PaymentStatus == "Pending")
                        {
                            <div class="actions">

                                @if (!limitReached)
                                {
                                    <form asp-action="Approve" method="post">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn-approve">

                                            <i class="bi bi-check-circle-fill"></i>
                                            Approve

                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn-limit" disabled>
                                        <i class="bi bi-exclamation-triangle"></i>
                                        Limit Reached (3/3)
                                    </button>
                                }

                                <form asp-action="Reject" method="post">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="btn-reject">

                                        <i class="bi bi-x-circle-fill"></i>
                                        Reject

                                    </button>
                                </form>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>
