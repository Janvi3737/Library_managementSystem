@model LibraryManagementSystem.ClassLibrary.Models.Membership

@{
    Layout = "~/Areas/Member/Views/Shared/_MemberLayout.cshtml";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>

    body {
        background: #050816;
        font-family: 'Inter', sans-serif;
        color: white;
    }

    .membership-page {
        padding: 40px;
        min-height: 100vh;
    }

    .membership-header {
        margin-bottom: 35px;
    }

    .membership-title {
        font-size: 42px;
        font-weight: 900;
        margin-bottom: 10px;
        background: linear-gradient(135deg, #7c3aed, #c084fc);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: #7c3aed; /* fallback for light mode */
    }

    .membership-subtitle {
        color: #9ca3af;
        font-size: 15px;
    }

    .membership-card {
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg,#0f172a,#081120);
        border-radius: 35px;
        padding: 40px;
        border: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 20px 60px rgba(0,0,0,.35);
    }

        .membership-card::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(168,85,247,.15);
            border-radius: 50%;
            top: -150px;
            right: -150px;
            filter: blur(40px);
        }

    .top-section {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 35px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .plan-box {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .plan-icon {
        width: 85px;
        height: 85px;
        border-radius: 24px;
        background: linear-gradient(135deg,#7c3aed,#d946ef);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 38px;
        color: white;
        box-shadow: 0 15px 35px rgba(168,85,247,.35);
    }

    .plan-name {
        font-size: 38px;
        font-weight: 900;
        margin-bottom: 6px;
    }

    .plan-text {
        color: #9ca3af;
        font-size: 15px;
    }

    .status-badge {
        padding: 12px 20px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 800;
    }

    .active-badge {
        background: rgba(34,197,94,.15);
        color: #4ade80;
    }

    .expired-badge {
        background: rgba(239,68,68,.15);
        color: #f87171;
    }

    .membership-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(240px,1fr));
        gap: 25px;
        margin-top: 20px;
    }

    .info-box {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 24px;
        padding: 28px;
        transition: .3s ease;
    }

        .info-box:hover {
            transform: translateY(-5px);
            border-color: rgba(168,85,247,.35);
        }

    .info-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        background: rgba(168,85,247,.15);
        color: #c084fc;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 26px;
        margin-bottom: 18px;
    }

    .info-label {
        color: #9ca3af;
        font-size: 14px;
        margin-bottom: 10px;
    }

    .info-value {
        font-size: 24px;
        font-weight: 800;
        color: white;
    }

    .renew-box {
        position: relative;
        z-index: 2;
        margin-top: 35px;
        text-align: center;
    }

    .renew-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        border: none;
        padding: 18px 30px;
        border-radius: 18px;
        background: linear-gradient(135deg,#f59e0b,#f97316);
        color: white;
        font-weight: 800;
        font-size: 16px;
        transition: .3s ease;
        box-shadow: 0 15px 35px rgba(249,115,22,.25);
    }

        .renew-btn:hover {
            transform: translateY(-4px);
            color: white;
        }

    @@media(max-width:768px) {

        .membership-page {
            padding: 20px;
        }

        .membership-title {
            font-size: 32px;
        }

        .membership-card {
            padding: 25px;
        }

        .plan-name {
            font-size: 28px;
        }

        .top-section {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<div class="membership-page">

    <!-- HEADER -->

    <div class="membership-header">

        <div class="membership-title">
            My Membership
        </div>

        <div class="membership-subtitle">
            Manage your library subscription and membership benefits
        </div>

    </div>

    <!-- CARD -->

    <div class="membership-card">

        <!-- TOP -->

        <div class="top-section">

            <div class="plan-box">

                <div class="plan-icon">

                    @if (Model.MembershipType == "Student")
                    {
                        <i class="bi bi-mortarboard-fill"></i>
                    }
                    else if (Model.MembershipType == "Regular")
                    {
                        <i class="bi bi-book-half"></i>
                    }
                    else
                    {
                        <i class="bi bi-gem"></i>
                    }

                </div>

                <div>

                    <div class="plan-name">
                        @Model.MembershipType Plan
                    </div>

                    <div class="plan-text">
                        Premium library membership access
                    </div>

                </div>

            </div>

            <div>

                @if (Model.IsActive)
                {
                    <div class="status-badge active-badge">
                        <i class="bi bi-check-circle-fill"></i>
                        Active Membership
                    </div>
                }
                else
                {
                    <div class="status-badge expired-badge">
                        <i class="bi bi-x-circle-fill"></i>
                        Membership Expired
                    </div>
                }

            </div>

        </div>

        <!-- DETAILS -->

        <div class="membership-grid">

            <div class="info-box">

                <div class="info-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <div class="info-label">
                    Start Date
                </div>

                <div class="info-value">
                    @Model.StartDate.ToString("dd MMM yyyy")
                </div>

            </div>

            <div class="info-box">

                <div class="info-icon">
                    <i class="bi bi-calendar-x"></i>
                </div>

                <div class="info-label">
                    Expiry Date
                </div>

                <div class="info-value">
                    @Model.EndDate.ToString("dd MMM yyyy")
                </div>

            </div>

            <div class="info-box">

                <div class="info-icon">
                    <i class="bi bi-currency-rupee"></i>
                </div>

                <div class="info-label">
                    Membership Fee
                </div>

                <div class="info-value">
                    ₹@Model.Fee
                </div>

            </div>

            <div class="info-box">

                <div class="info-icon">
                    <i class="bi bi-clock-history"></i>
                </div>

                <div class="info-label">
                    Duration
                </div>

                <div class="info-value">
                    @Model.DurationMonths Month(s)
                </div>

            </div>

        </div>

        <!-- RENEW -->
        @if (Model.EndDate < DateTime.Now)
        {
            <div class="renew-box">

                <a asp-controller="Membership"
                   asp-action="Renew"
                   asp-route-membershipId="@Model.Id"
                   class="renew-btn">

                    <i class="bi bi-arrow-repeat"></i>

                    Renew Membership

                </a>

            </div>
        }

    </div>

</div>
