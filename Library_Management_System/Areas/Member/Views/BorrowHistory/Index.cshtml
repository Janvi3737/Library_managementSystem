@{
    Layout = "~/Areas/Member/Views/Shared/_MemberLayout.cshtml";
}

@model List<Library_Management_System.ViewModels.BorrowHistoryViewModel>

@{
    ViewData["Title"] = "Borrow History";
}


<style>

    body {
        background: #050816;
        color: white;
        font-family: 'Segoe UI', sans-serif;
    }

    .history-wrapper {
        padding: 35px;
    }

    .page-title {
        font-size: 34px;
        font-weight: 800;
        margin-bottom: 30px;
    }

    /* FILTER */

    .filter-box {
        display: flex;
        gap: 15px;
        margin-bottom: 35px;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 11px 20px;
        border-radius: 14px;
        text-decoration: none;
        color: white;
        background: #111827;
        border: 1px solid rgba(255,255,255,.08);
        transition: .3s;
        font-weight: 600;
    }

        .filter-btn:hover,
        .filter-btn.active {
            background: linear-gradient(135deg,#7c3aed,#9333ea);
            color: white;
        }

    /* TIMELINE */

    .timeline {
        position: relative;
        margin-left: 12px;
        padding-left: 30px;
        border-left: 3px solid #7c3aed;
    }

    .timeline-item {
        position: relative;
        margin-bottom: 35px;
    }

    .timeline-dot {
        position: absolute;
        left: -42px;
        top: 14px;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: #9333ea;
        border: 3px solid #050816;
    }

    /* CARD */

    .history-card {
        background: linear-gradient(145deg,#0f172a,#111827);
        border-radius: 24px;
        padding: 24px;
        border: 1px solid rgba(255,255,255,.06);
        box-shadow: 0 0 30px rgba(124,58,237,.12);
        transition: .3s;
    }

        .history-card:hover {
            transform: translateY(-5px);
        }

    .book-title {
        font-size: 22px;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .author-name {
        color: #9ca3af;
        margin-bottom: 20px;
    }

    /* INFO GRID */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(180px,1fr));
        gap: 16px;
        margin-top: 20px;
    }

    .info-box {
        background: rgba(255,255,255,.04);
        border-radius: 16px;
        padding: 16px;
        border: 1px solid rgba(255,255,255,.04);
    }

    .info-title {
        color: #9ca3af;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .info-value {
        font-size: 15px;
        font-weight: 700;
    }

    /* STATUS */

    .badge-status {
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
    }

    .active-status {
        background: #16a34a;
    }

    .returned-status {
        background: #2563eb;
    }

    .overdue-status {
        background: #dc2626;
    }

    /* FINE */

    .fine-paid {
        color: #22c55e;
        font-weight: 700;
    }

    .fine-unpaid {
        color: #ef4444;
        font-weight: 700;
    }

    /* BUTTON */

    .return-btn {
        background: linear-gradient(135deg,#dc2626,#ef4444);
        border: none;
        padding: 12px 22px;
        border-radius: 14px;
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: .3s;
    }

        .return-btn:hover {
            transform: translateY(-3px);
            color: white;
        }

    /* EMPTY */

    .empty-box {
        background: #111827;
        border-radius: 20px;
        padding: 40px;
        text-align: center;
        color: #9ca3af;
        border: 1px solid rgba(255,255,255,.05);
    }

</style>

<div class="history-wrapper">

    <div class="page-title">
        📚 Borrow History Timeline
    </div>

    <!-- FILTERS -->

    <div class="filter-box">

        <a asp-action="Index"
           class="filter-btn @(ViewBag.CurrentStatus == null ? "active" : "")">
            All
        </a>

        <a asp-action="Index"
           asp-route-status="active"
           class="filter-btn @(ViewBag.CurrentStatus == "active" ? "active" : "")">
            Active
        </a>

        <a asp-action="Index"
           asp-route-status="returned"
           class="filter-btn @(ViewBag.CurrentStatus == "returned" ? "active" : "")">
            Returned
        </a>

        <a asp-action="Index"
           asp-route-status="overdue"
           class="filter-btn @(ViewBag.CurrentStatus == "overdue" ? "active" : "")">
            Overdue
        </a>

    </div>

    @if (Model.Any())
    {
        <div class="timeline">

            @foreach (var item in Model)
            {
                <div class="timeline-item">

                    <div class="timeline-dot"></div>

                    <div class="history-card">

                        <div class="d-flex justify-content-between align-items-start flex-wrap">

                            <div>

                                <div class="book-title">
                                    @item.BookTitle
                                </div>

                                <div class="author-name">
                                    by @item.Author
                                </div>

                            </div>

                            <div>

                                @if (item.Status == "Returned")
                                {
                                    <span class="badge-status returned-status">
                                        Returned
                                    </span>
                                }
                                else if (item.Status == "Overdue")
                                {
                                    <span class="badge-status overdue-status">
                                        Overdue
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status active-status">
                                        Active
                                    </span>
                                }

                            </div>

                        </div>

                        <!-- INFO GRID -->

                        <div class="info-grid">

                            <div class="info-box">

                                <div class="info-title">
                                    Borrow Date
                                </div>

                                <div class="info-value">
                                    @item.BorrowDate.ToShortDateString()
                                </div>

                            </div>

                            <div class="info-box">

                                <div class="info-title">
                                    Due Date
                                </div>

                                <div class="info-value">
                                    @item.DueDate.ToShortDateString()
                                </div>

                            </div>

                            <div class="info-box">

                                <div class="info-title">
                                    Return Date
                                </div>

                                <div class="info-value">

                                    @(item.ReturnDate.HasValue
                                                                ? item.ReturnDate.Value.ToShortDateString()
                                                                : "Not Returned")

                                </div>

                            </div>

                            <div class="info-box">

                                <div class="info-title">
                                    Fine Amount
                                </div>

                                <div class="info-value">
                                    ₹@item.FineAmount
                                </div>

                            </div>

                            <div class="info-box">

                                <div class="info-title">
                                    Fine Per Day
                                </div>

                                <div class="info-value">
                                    ₹@item.FinePerDay
                                </div>

                            </div>

                            <div class="info-box">

                                <div class="info-title">
                                    Days Late
                                </div>

                                <div class="info-value">
                                    @item.DaysLate Days
                                </div>

                            </div>

                            <div class="info-box">

                                <div class="info-title">
                                    Fine Payment
                                </div>

                                <div class="info-value">

                                    @if (item.FinePaid)
                                    {
                                        <span class="fine-paid">
                                            Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fine-unpaid">
                                            Unpaid
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                        <!-- RETURN BUTTON -->
                        @if (item.Status != "Returned")
                        {
                            <div class="mt-4 d-flex justify-content-end">

                                <a asp-action="ReturnBook"
                                   asp-controller="BorrowHistory"
                                   asp-route-id="@item.Id"
                                   class="return-btn">

                                    Return Book

                                </a>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-box">
            No borrow history found.
        </div>
    }

</div>
