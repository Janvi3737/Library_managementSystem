@model Library_Management_System.ViewModels.MemberAnalyticsViewModel

@{
    ViewData["Title"] = "Reports & Analytics";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

    :root {
        --bg: #060816;
        --card: rgba(255, 255, 255, .07);
        --border: rgba(255, 255, 255, .08);
        --text: #fff;
        --muted: #b9b6d3;
        --purple: #8b5cf6;
        --purple2: #a855f7;
        --blue: #3b82f6;
        --cyan: #06b6d4;
        --green: #22c55e;
        --orange: #f59e0b;
        --pink: #ec4899;
    }

    body {
        background: #070b17;
        color: white;
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        overflow-x: hidden;
    }

        body::before {
            content: '';
            position: fixed;
            width: 450px;
            height: 450px;
            border-radius: 50%;
            background: #8b5cf6;
            filter: blur(180px);
            opacity: .15;
            top: -150px;
            left: -100px;
            z-index: -1;
        }

        body::after {
            content: '';
            position: fixed;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: #2563eb;
            filter: blur(180px);
            opacity: .15;
            bottom: -180px;
            right: -150px;
            z-index: -1;
        }

    .analytics-page {
        padding: 20px;
    }

    /* HERO */

    .page-header {
        background: linear-gradient(135deg, rgba(139, 92, 246, .18), rgba(59, 130, 246, .15));
        border: 1px solid rgba(255, 255, 255, .08);
        color: #060816;
        backdrop-filter: blur(20px);
        border-radius: 32px;
        padding: 35px;
        margin-bottom: 35px;
        overflow: hidden;
        position: relative;
    }

        .page-header::before {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            background: #8b5cf6;
            color: #060816;
            filter: blur(100px);
            opacity: .25;
            right: -50px;
            top: -50px;
        }

    .page-title {
        font-size: 46px;
        font-weight: 900;
        margin-bottom: 10px;
        background: linear-gradient(to right, #fff, #d8b4fe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: mediumpurple;
    }

    .page-subtitle {
        color: black;
        font-size: 16px;
    }

    /* STATS */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 22px;
        margin-bottom: 35px;
    }

    .stat-card {
        background: var(--card);
        backdrop-filter: blur(24px);
        border: 1px solid var(--border);
        border-radius: 28px;
        padding: 26px;
        transition: .35s;
        overflow: hidden;
        position: relative;
    }

        .stat-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, .3), 0 0 25px rgba(139, 92, 246, .25);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255, 255, 255, .08), transparent);
        }

    .stat-icon {
        width: 74px;
        height: 74px;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 28px;
    }

    .purple {
        background: linear-gradient(135deg, #8b5cf6, #6d28d9);
    }

    .blue {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
    }

    .green {
        background: linear-gradient(135deg, #22c55e, #15803d);
    }

    .orange {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .pink {
        background: linear-gradient(135deg, #ec4899, #be185d);
    }

    .stat-value {
        font-size: 42px;
        font-weight: 900;
        margin-top: 20px;
    }

    .stat-label {
        color: #cfc9e8;
        margin-top: 8px;
    }

    .trend-card {
        position: relative;
        overflow: hidden;
    }

        .trend-card::before {
            content: '';
            position: absolute;
            width: 350px;
            height: 350px;
            background: #8b5cf6;
            filter: blur(140px);
            opacity: .12;
            top: -150px;
            right: -100px;
        }

        .trend-card::after {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: #22c55e;
            filter: blur(140px);
            opacity: .08;
            bottom: -150px;
            left: -100px;
        }

    .chart-container {
        height: 420px;
        position: relative;
    }

    .trend-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .trend-subtitle {
        color: #b8b4d4;
        font-size: 14px;
    }

    .trend-badge {
        padding: 8px 15px;
        border-radius: 12px;
        background: rgba(139, 92, 246, .15);
        color: #b794ff;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid rgba(139, 92, 246, .25);
    }

    .chart-container {
        height: 320px;
        position: relative;
    }

    /* CONTENT */

    .content-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 25px;
        margin-bottom: 25px;
        margin-top: 25px;
        align-items: stretch;
    }

    .glass-card {
        background: rgba(255, 255, 255, .06);
        border: 1px solid rgba(255, 255, 255, .08);
        backdrop-filter: blur(24px);
        border-radius: 28px;
        padding: 30px;
    }

    .card-title {
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 22px;
    }

    /* INFO BOX */

    .info-box {
        background: rgba(255, 255, 255, .05);
        border: 1px solid rgba(255, 255, 255, .06);
        border-radius: 20px;
        padding: 18px;
        margin-bottom: 15px;
        transition: .3s;
    }

        .info-box:hover {
            background: rgba(255, 255, 255, .08);
        }

    .info-title {
        color: #bfb8d9;
        font-size: 13px;
        margin-bottom: 6px;
    }

    .info-value {
        font-size: 24px;
        font-weight: 800;
    }

    /* COMPLETION */

    .progress {
        background: rgba(255, 255, 255, .08);
        border-radius: 999px;
        height: 12px;
        overflow: hidden;
    }

    .progress-bar {
        background: linear-gradient(90deg, #8b5cf6, #ec4899);
        border-radius: 999px;
    }

    /* TABLE */

    .table-responsive {
        overflow: hidden;
        border-radius: 20px;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
    }

        .custom-table th {
            background: rgba(255, 255, 255, .08);
            padding: 18px;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #cfc9e8;
        }

        .custom-table td {
            padding: 14px;
            color: #ddd;
            border-bottom: 1px solid rgba(255, 255, 255, .05);
        }

        .custom-table tr:hover {
            background: rgba(255, 255, 255, .04);
        }

    .glass-card {
        transition: 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-4px);
        }

    /* ACTIVITY */

    .activity-card {
        text-align: center;
    }

    .activity-icon {
        width: 140px;
        height: 140px;
        margin: auto;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 55px;
        color: white;
        margin-bottom: 25px;
        background: linear-gradient(135deg, #8b5cf6, #ec4899);
        box-shadow: 0 0 35px rgba(139, 92, 246, .45);
    }

    .activity-title {
        font-size: 30px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .activity-text {
        color: #d6d1ef;
        line-height: 1.9;
    }

    /* RESPONSIVE */

    @@media (max-width: 992px) {
        .analytics-page {
            padding: 20px;
        }

        .content-grid {
            grid-template-columns: 1fr;
        }

        .page-title {
            font-size: 34px;
        }

        .stat-value {
            font-size: 34px;
        }
    }

    .stat-card,
    .glass-card,
    .page-header {
        animation: fadeUp .6s ease forwards;
    }

    @@keyframes fadeUp {

        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .fine-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .fine-card {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 18px;
        padding: 16px;
        transition: .3s;
    }

        .fine-card:hover {
            transform: translateY(-4px);
            background: rgba(255, 255, 255, 0.09);
        }

    .fine-month {
        font-size: 14px;
        color: #cfc9e8;
    }

    .fine-value {
        font-size: 22px;
        font-weight: 800;
        margin-top: 8px;
        color: #f59e0b;
    }

    .fine-meta {
        font-size: 12px;
        margin-top: 8px;
        color: #aaa;
    }
</style>

<div class="analytics-page">

    <div class="page-header">
        <div class="page-title">Reports & Analytics</div>
        <div class="page-subtitle">
            Insights about your reading and borrowing activities
        </div>
    </div>


    <!-- STATS -->

    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon purple">
                <i class="fa-solid fa-book-open"></i>
            </div>
            <div class="stat-value">@Model.TotalBorrowed</div>
            <div class="stat-label">Total Books Borrowed</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="fa-solid fa-book"></i>
            </div>
            <div class="stat-value">@Model.CurrentBorrowed</div>
            <div class="stat-label">Currently Borrowed</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div class="stat-value">@Model.TotalReturned</div>
            <div class="stat-label">Books Returned</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="fa-solid fa-clock"></i>
            </div>
            <div class="stat-value">@Model.OverdueBooks</div>
            <div class="stat-label">Overdue Books</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon pink">
                <i class="fa-solid fa-wallet"></i>
            </div>
            <div class="stat-value">₹@Model.TotalFine</div>
            <div class="stat-label">Total Fine</div>
        </div>

    </div>

    <div class="glass-card trend-card">

        <div class="trend-header">

            <div>
                <h3 class="card-title mb-1">
                    <i class="fa-solid fa-chart-line me-2"></i>
                    Borrowing Trend
                </h3>

                <span class="trend-subtitle">
                    Borrowed vs Returned Books
                </span>
            </div>

            <div class="trend-badge">
                @DateTime.Now.AddMonths(-5).ToString("MMM yyyy")
                -
                @DateTime.Now.ToString("MMM yyyy")
            </div>

        </div>

        <div class="chart-container">
            <canvas id="borrowTrendChart"></canvas>
        </div>

    </div>

    <!-- ANALYTICS -->

    <div class="content-grid">

        <div class="glass-card">

            <div class="card-title">
                Reading Insights
            </div>

            <div class="info-box">
                <div class="info-title">Books Borrowed This Month</div>
                <div class="info-value">@Model.BooksThisMonth</div>
            </div>

            <div class="info-box">
                <div class="info-title">Wishlist Books</div>
                <div class="info-value">@Model.TotalWishlist</div>
            </div>

            <div class="info-box">
                <div class="info-title">Favourite Category</div>
                <div class="info-value">@Model.FavoriteCategory</div>
            </div>

            <div class="info-box">
                <div class="info-title">Favourite Author</div>
                <div class="info-value">@Model.FavoriteAuthor</div>
            </div>

        </div>

        <div class="glass-card">

            <div class="activity-icon">
                <i class="fa-solid fa-book-open-reader"></i>
            </div>

            <div class="activity-title">
                Great Going!
            </div>

            <div class="activity-text">

                You borrowed
                <strong>@Model.BooksThisMonth</strong>
                books this month.

                <br />

                <h2>@Model.CompletionRate%</h2>

                <div class="progress mt-3">
                    <div class="progress-bar" style="width:@Model.CompletionRate%">
                    </div>
                </div>

                <p class="mt-3 text-light">
                    Percentage of borrowed books returned.
                </p>

            </div>

        </div>

    </div>

    <!-- MONTHLY TABLE -->

    <div class="content-grid">

        <!-- LEFT: TABLE -->
        <div class="glass-card">

            <div class="card-title">
                Monthly Overview
            </div>

            <div class="table-responsive">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Books Borrowed</th>
                            <th>Books Returned</th>
                            <th>Overdue</th>
                            <th>Fines</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.MonthlyData)
                        {
                            <tr>
                                <td>@item.Month</td>
                                <td>@item.Borrowed</td>
                                <td>@item.Returned</td>
                                <td>@item.Borrowed - @item.Returned</td>
                                <td>₹@item.Fine</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div style="margin-top:20px;text-align:center;">
                <button class="trend-badge">View Full History →</button>
            </div>

        </div>

        <!-- RIGHT: CHART -->
        <div class="glass-card trend-card">

            <div class="trend-header">
                <div>
                    <div class="card-title">Fine Summary</div>
                    <span class="trend-subtitle">Monthly fines overview</span>
                </div>

                <div class="trend-badge">
                    Monthly
                </div>
            </div>

            <div class="fine-grid">

                @foreach (var item in Model.MonthlyData)
                {
                    <div class="fine-card">
                        <div class="fine-month">@item.Month</div>

                        <div class="fine-value">₹@item.Fine</div>

                        <div class="fine-meta">
                            Borrowed: @item.Borrowed | Retu
                            rned: @item.Returned
                        </div>
                    </div>
                }

            </div>

        </div>

    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const labels = [
    @Html.Raw(string.Join(",",
        Model.MonthlyData.Select(x => $"'{x.Month}'")))
    ];

    const borrowed = [
    @string.Join(",", Model.MonthlyData.Select(x => x.Borrowed))
    ];

    const returnedBooks = [
    @string.Join(",", Model.MonthlyData.Select(x => x.Returned))
    ];

    const canvas = document.getElementById("borrowTrendChart");
    const ctx = canvas.getContext("2d");

    /* Purple Gradient */
    const purpleGradient = ctx.createLinearGradient(0, 0, 0, 400);
    purpleGradient.addColorStop(0, "rgba(139,92,246,.45)");
    purpleGradient.addColorStop(1, "rgba(139,92,246,0)");

    /* Green Gradient */
    const greenGradient = ctx.createLinearGradient(0, 0, 0, 400);
    greenGradient.addColorStop(0, "rgba(34,197,94,.35)");
    greenGradient.addColorStop(1, "rgba(34,197,94,0)");

    new Chart(ctx, {

    type: "line",

    data: {

    labels: labels,

    datasets: [

    {
    label: "Books Borrowed",

    data: borrowed,

    borderColor: "#8b5cf6",
    backgroundColor: purpleGradient,

    fill: true,

    tension: 0.45,

    borderWidth: 4,

    pointRadius: 5,
    pointHoverRadius: 9,

    pointBackgroundColor: "#8b5cf6",
    pointBorderColor: "#ffffff",
    pointBorderWidth: 2,

    hoverBorderWidth: 3
    },

    {
    label: "Books Returned",

    data: returnedBooks,

    borderColor: "#22c55e",
    backgroundColor: greenGradient,

    fill: true,

    tension: 0.45,

    borderWidth: 4,

    pointRadius: 5,
    pointHoverRadius: 9,

    pointBackgroundColor: "#22c55e",
    pointBorderColor: "#ffffff",
    pointBorderWidth: 2,

    hoverBorderWidth: 3
    }

    ]
    },

    options: {

    responsive: true,
    maintainAspectRatio: false,

    interaction: {
    mode: "index",
    intersect: false
    },

    animation: {
    duration: 1800,
    easing: "easeOutQuart"
    },

    plugins: {

    legend: {

    position: "top",

    labels: {

    color: "#ffffff",

    usePointStyle: true,

    pointStyle: "circle",

    padding: 25,

    font: {
    size: 13,
    weight: "600"
    }
    }
    },

    tooltip: {

    backgroundColor: "#111827",

    titleColor: "#ffffff",

    bodyColor: "#ffffff",

    borderColor: "#8b5cf6",

    borderWidth: 1,

    cornerRadius: 12,

    padding: 14,

    displayColors: true,

    callbacks: {

    label: function (context) {

    return context.dataset.label +
    ": " +
    context.parsed.y +
    " books";
    }
    }
    }
    },

    scales: {

    x: {

    ticks: {

    color: "#d1cfe7",

    font: {
    size: 12,
    weight: "500"
    }
    },

    grid: {
    display: false
    },

    border: {
    display: false
    }
    },

    y: {

    beginAtZero: true,

    ticks: {

    color: "#d1cfe7",

    stepSize: 1,

    font: {
    size: 12
    }
    },

    grid: {

    color: "rgba(255,255,255,.06)",

    drawBorder: false
    },

    border: {
    display: false
    }
    }
    }
    }
    });

</script>
