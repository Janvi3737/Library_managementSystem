@model LibraryManagementSystem.ClassLibrary.Models.Event

@{
    Layout = "~/Areas/Member/Views/Shared/_MemberLayout.cshtml";
}
<style>

    .confirm-wrapper {
        display: flex;
        justify-content: center;
        padding: 60px 20px;
    }

    .confirm-card {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        max-width: 1100px;
        width: 100%;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 28px;
        overflow: hidden;
        box-shadow: var(--shadow);
    }

    .left {
        padding: 40px;
        background: linear-gradient(135deg,#7c3aed,#d946ef);
        color: white;
    }

        .left h1 {
            font-size: 36px;
            font-weight: 900;
            margin-bottom: 15px;
            color: white;
        }

        .left p {
            opacity: .92;
            line-height: 1.8;
            color: rgba(255,255,255,.92);
        }

    .right {
        padding: 40px;
        background: var(--card);
    }

    .info-box {
        background: var(--card-2);
        padding: 16px;
        border-radius: 14px;
        margin-bottom: 14px;
        border: 1px solid var(--border);
        color: var(--text);
        transition: .3s ease;
    }

        .info-box:hover {
            transform: translateY(-2px);
            border-color: rgba(124,58,237,.35);
        }

        .info-box b {
            color: var(--text);
        }

    .btn-confirm {
        width: 100%;
        padding: 16px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg,#10b981,#22c55e);
        font-weight: 700;
        color: white !important;
        margin-top: 20px;
        transition: .3s ease;
        box-shadow: 0 12px 24px rgba(16,185,129,.2);
    }

        .btn-confirm:hover {
            transform: translateY(-3px);
            box-shadow: 0 18px 30px rgba(16,185,129,.3);
        }

    @@media(max-width:991px) {

        .confirm-card {
            grid-template-columns: 1fr;
        }

        .left,
        .right {
            padding: 30px;
        }
    }

    @@media(max-width:768px) {

        .confirm-wrapper {
            padding: 25px 15px;
        }

        .left h1 {
            font-size: 28px;
        }
    }

</style>
<div class="confirm-wrapper">

    <div class="confirm-card">

        <div class="left">
            <h1>@Model.Title</h1>
            <p>@Model.Description</p>
        </div>

        <div class="right">

            <div class="info-box">
                <b>Date:</b> @Model.Date.ToString("dd MMM yyyy")
            </div>

            <div class="info-box">
                <b>Location:</b> @Model.Location
            </div>

            <div class="info-box">
                <b>Status:</b> Confirm reservation to continue
            </div>

            <form asp-area="Member"
                  asp-controller="EventReservation"
                  asp-action="ConfirmReservation"
                  method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" name="eventId" value="@Model.Id" />

                <button class="btn-confirm">
                    Confirm Reservation
                </button>

            </form>

        </div>

    </div>

</div>
