@model List<LibraryManagementSystem.ClassLibrary.Models.EventReservation>

@{
    Layout = "~/Areas/Member/Views/Shared/_MemberLayout.cshtml";
    ViewData["Title"] = "My Event Reservations";
}
<style>

    .reservation-wrapper {
        padding: 30px;
    }

    .page-title {
        font-size: 34px;
        font-weight: 800;
        margin-bottom: 30px;
        color: var(--text);
    }

    .reservation-card {
        background: var(--card);
        border-radius: 24px;
        padding: 24px;
        margin-bottom: 22px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        transition: .3s ease;
    }

        .reservation-card:hover {
            transform: translateY(-5px);
        }

    .event-title {
        font-size: 24px;
        font-weight: 700;
        color: var(--text);
    }

    .event-location {
        color: var(--text-muted);
        margin-top: 5px;
    }

    .reservation-info {
        margin-top: 20px;
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
    }

    .info-box {
        background: var(--card-2);
        padding: 14px 18px;
        border-radius: 14px;
        min-width: 180px;
        flex: 1;
        border: 1px solid var(--border);
        transition: .3s ease;
    }

        .info-box:hover {
            transform: translateY(-3px);
            border-color: rgba(124,58,237,.4);
        }

    .info-title {
        color: var(--text-muted);
        font-size: 13px;
        margin-bottom: 8px;
    }

    .info-value {
        font-size: 18px;
        font-weight: 700;
        color: var(--text);
    }

    .status-badge {
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
    }

    .pending {
        background: #f59e0b;
        color: #111827;
    }

    .approved {
        background: #10b981;
        color: white;
    }

    .rejected {
        background: #ef4444;
        color: white;
    }

    .btn-cancel {
        background: linear-gradient(135deg,#dc2626,#ef4444);
        color: white !important;
        border: none;
        padding: 12px 20px;
        border-radius: 12px;
        font-weight: 700;
        margin-top: 20px;
        transition: .3s ease;
    }

        .btn-cancel:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(239,68,68,.25);
        }

    .empty-box {
        background: var(--card);
        border-radius: 20px;
        padding: 50px;
        text-align: center;
        color: var(--text-muted);
        border: 1px solid var(--border);
    }

    @@media(max-width:768px) {

        .reservation-wrapper {
            padding: 20px;
        }

        .reservation-info {
            flex-direction: column;
        }

        .event-title {
            font-size: 20px;
        }
    }

</style>

<div class="reservation-wrapper">

    <div class="page-title">
        🎟️ My Event Reservations
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-box">
            No event reservations found.
        </div>
    }
    else
    {
        @foreach (var item in Model)
        {
            var status = item.Status?.Trim().ToLower();

            <div class="reservation-card">

                <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">

                    <div>

                        <div class="event-title">
                            @item.Event?.Title
                        </div>

                        <div class="event-location">
                            📍 @item.Event?.Location
                        </div>

                    </div>

                    <div>

                        @if (status == "pending")
                        {
                            <span class="status-badge pending">
                                Pending
                            </span>
                        }
                        else if (status == "approved")
                        {
                            <span class="status-badge approved">
                                Approved
                            </span>
                        }
                        else if (status == "rejected")
                        {
                            <span class="status-badge rejected">
                                Rejected
                            </span>
                        }

                    </div>

                </div>

                <div class="reservation-info">

                    <div class="info-box">

                        <div class="info-title">
                            Event Date
                        </div>

                        <div class="info-value">
                            @(item.Event?.Date.ToString("dd MMM yyyy"))
                        </div>

                    </div>

                    <div class="info-box">

                        <div class="info-title">
                            Reserved On
                        </div>

                        <div class="info-value">
                            @item.ReservedOn.ToString("dd MMM yyyy")
                        </div>

                    </div>

                    <div class="info-box">

                        <div class="info-title">
                            Status
                        </div>

                        <div class="info-value">
                            @item.Status
                        </div>

                    </div>

                </div>

                @if (status == "pending")
                {
                    <form asp-area="Member"
                          asp-controller="EventReservation"
                          asp-action="Cancel"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@item.Id" />

                        <button type="submit"
                                class="btn-cancel">
                            Cancel Reservation
                        </button>

                    </form>
                }

            </div>
        }
    }

</div>
