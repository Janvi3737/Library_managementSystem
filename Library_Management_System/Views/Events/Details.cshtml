@model LibraryManagementSystem.ClassLibrary.Models.Event

@{
    Layout = "~/Areas/Member/Views/Shared/_MemberLayout.cshtml";
    ViewData["Title"] = "Event Details";

    string speakerName = "James Clear";
    string speakerDesc = "Bestselling author and productivity expert known for inspiring readers through modern self-improvement.";
    string speakerImage = "/images/default-speaker.svg";

    if (Model.Title.Contains("Atomic Habits"))
    {
        speakerName = "James Clear";
        speakerDesc = "Author of Atomic Habits and expert in habits and productivity.";
    }
    else if (Model.Title.Contains("Rich Dad"))
    {
        speakerName = "Robert Kiyosaki";
        speakerDesc = "Entrepreneur and financial educator.";
    }
    else if (Model.Title.Contains("Alchemist"))
    {
        speakerName = "Paulo Coelho";
        speakerDesc = "Inspirational novelist and storyteller.";
    }
    else if (Model.Title.Contains("Clean Code"))
    {
        speakerName = "Robert C. Martin";
        speakerDesc = "Software engineering expert and Clean Code author.";
    }
    else if (Model.Title.Contains("Wings of Fire"))
    {
        speakerName = "Dr. A.P.J Abdul Kalam";
        speakerDesc = "Former President of India and inspirational leader.";
    }
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

    /* ================= THEME ================= */

    :root {
        --bg: #050816;
        --page-bg: radial-gradient(circle at top left, rgba(124, 58, 237, .12), transparent 25%), radial-gradient(circle at bottom right, rgba(217, 70, 239, .08), transparent 30%), #050816;
        --card-bg: rgba(255, 255, 255, .04);
        --border: rgba(255, 255, 255, .08);
        --text: #fff;
        --text-light: #d1d5db;
        --shadow: 0 20px 60px rgba(0, 0, 0, .45);
    }

    /* LIGHT MODE */
    body.light-mode {
        --bg: #f8fafc;
        --page-bg: radial-gradient(circle at top left, rgba(124, 58, 237, .08), transparent 25%), radial-gradient(circle at bottom right, rgba(217, 70, 239, .06), transparent 30%), #f8fafc;
        --card-bg: rgba(255, 255, 255, .9);
        --border: rgba(0, 0, 0, .08);
        --text: #0f172a;
        --text-light: #475569;
        --shadow: 0 20px 60px rgba(0, 0, 0, .12);
    }

    /* ================= BASE ================= */

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', sans-serif;
        background: var(--bg);
        color: var(--text);
    }

    .event-page {
        min-height: 100vh;
        padding: 35px 24px 80px;
        background: var(--page-bg);
    }

    /* ================= HERO ================= */

    .event-hero {
        position: relative;
        display: flex;
        align-items: center;
        padding: 50px;
        border-radius: 36px;
        background: linear-gradient(rgba(7, 11, 26, .88), rgba(15, 23, 42, .92)), url('/images/library-banner.png');
        background-size: cover;
        background-position: center;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    body.light-mode .event-hero {
        background: linear-gradient(rgba(255, 255, 255, .90), rgba(248, 250, 252, .95)), url('/images/library-banner.png');
    }

    /* glow */
    .event-hero::before,
    .event-hero::after {
        content: "";
        position: absolute;
        filter: blur(80px);
    }

    .event-hero::before {
        width: 420px;
        height: 420px;
        background: rgba(168, 85, 247, .12);
        top: -160px;
        right: -120px;
    }

    .event-hero::after {
        width: 260px;
        height: 260px;
        background: rgba(236, 72, 153, .10);
        bottom: -100px;
        left: -80px;
    }

    /* ================= IMAGE ================= */

    .event-image {
        width: 100%;
        height: 520px;
        object-fit: cover;
        border-radius: 30px;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    /* ================= BADGE ================= */

    .event-badge {
        display: inline-flex;
        padding: 12px 22px;
        border-radius: 50px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        font-size: 13px;
        font-weight: 700;
    }

    /* ================= TITLE ================= */

    .event-title {
        font-size: 60px;
        font-weight: 900;
    }

        .event-title span {
            background: linear-gradient(90deg, #c084fc, #f0abfc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    /* ================= META ================= */

    .event-meta-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
    }

    .meta-card {
        padding: 22px;
        border-radius: 24px;
        background: var(--card-bg);
        border: 1px solid var(--border);
    }

    /* ================= BUTTON ================= */

    .reserve-btn {
        display: inline-flex;
        padding: 16px 32px;
        border-radius: 22px;
        background: linear-gradient(135deg, #7c3aed, #d946ef);
        color: white;
        font-weight: 700;
    }

    /* ================= GLASS ================= */

    .glass-card {
        padding: 30px;
        border-radius: 34px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    /* ================= SPEAKER ================= */

    .speaker-box {
        display: flex;
        gap: 25px;
    }

    .speaker-image {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        overflow: hidden;
        border: 4px solid rgba(168, 85, 247, .35);
    }

    /* ================= SUMMARY ================= */

    /* ================= EVENT SUMMARY (NEW DESIGN) ================= */

    .summary-card {
        position: sticky;
        top: 110px;
        padding: 28px;
        border-radius: 28px;
        background: var(--card-bg);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        backdrop-filter: blur(14px);
    }

    .summary-title {
        font-size: 22px;
        font-weight: 900;
        margin-bottom: 20px;
        color: var(--text);
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .summary-title::before {
            content: "📊";
            font-size: 18px;
        }

    .summary-grid {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .summary-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 16px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--border);
        transition: 0.25s ease;
    }

        .summary-item:hover {
            transform: translateX(6px);
            border-color: rgba(168, 85, 247, 0.35);
            background: rgba(168, 85, 247, 0.06);
        }

    .summary-icon {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #7c3aed, #d946ef);
        color: #fff;
        font-size: 18px;
        box-shadow: 0 8px 18px rgba(124, 58, 237, 0.25);
    }

    .summary-text small {
        display: block;
        font-size: 11px;
        color: var(--text-light);
        margin-bottom: 2px;
    }

    .summary-text strong {
        font-size: 14px;
        color: var(--text);
        font-weight: 700;
    }

    /* divider */
    .summary-divider {
        height: 1px;
        background: var(--border);
        margin: 14px 0;
    }

    /* CTA inside summary */
    .summary-cta {
        margin-top: 16px;
    }

    .summary-btn {
        width: 100%;
        display: flex;
        justify-content: center;
        padding: 12px 16px;
        border-radius: 14px;
        background: linear-gradient(90deg, #7c3aed, #9333ea);
        color: white;
        font-weight: 700;
        text-decoration: none;
        transition: 0.3s;
    }

        .summary-btn:hover {
            transform: translateY(-2px);
        }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 992px) {
        .event-title {
            font-size: 42px;
        }

        .event-image {
            height: 420px;
        }
    }

    @@media (max-width: 768px) {
        .event-hero {
            flex-direction: column;
            padding: 25px;
        }

        .event-title {
            font-size: 32px;
        }

        .event-image {
            height: 320px;
        }
    }
</style>

<div class="event-page">
    <div class="row g-4">

        <!-- LEFT -->
        <div class="col-lg-8">

            <div class="event-hero">
                <div class="hero-inner">

                    <div class="row g-4 align-items-center">

                        <div class="col-lg-5">
                            <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/no-event.svg" : Model.ImagePath)"
                                 class="event-image" />
                        </div>

                        <div class="col-lg-7">

                            <div class="event-badge">
                                ✨ PREMIUM AUTHOR EVENT
                            </div>

                            <div class="event-title">
                                Discover <span>@Model.Title</span>
                            </div>

                            <div class="event-description">
                                @Model.Description
                            </div>

                            <div class="event-meta-grid">

                                <div class="meta-card">
                                    📅 @Model.Date.ToString("dd MMM yyyy")
                                </div>

                                <div class="meta-card">
                                    ⏰ 4:00 PM - 6:00 PM
                                </div>

                            </div>

                            <form asp-area="Member" asp-controller="EventReservation" asp-action="Create" method="get">

                                <input type="hidden" name="eventId" value="@Model.Id" />

                                <button class="reserve-btn">
                                    🎟 Reserve Seat
                                </button>
                            </form>

                        </div>

                    </div>
                </div>
            </div>

            <div class="glass-card">
                <h2>About Speaker</h2>

                <div class="speaker-box">
                    <div class="speaker-image">
                        <img src="@speakerImage" />
                    </div>

                    <div>
                        <div class="speaker-name">@speakerName</div>
                        <div class="speaker-desc">@speakerDesc</div>
                    </div>
                </div>
            </div>

        </div>

        <!-- RIGHT -->
        <div class="col-lg-4">

            <div class="glass-card summary-card">

                <div class="summary-title">
                    Event Summary
                </div>

                <div class="summary-grid">

                    <div class="summary-item">
                        <div class="summary-icon">📅</div>
                        <div class="summary-text">
                            <small>Date</small>
                            <strong>@Model.Date.ToString("dd MMM yyyy")</strong>
                        </div>
                    </div>

                    <div class="summary-item">
                        <div class="summary-icon">📍</div>
                        <div class="summary-text">
                            <small>Location</small>
                            <strong>@Model.Location</strong>
                        </div>
                    </div>

                    <div class="summary-item">
                        <div class="summary-icon">🎤</div>
                        <div class="summary-text">
                            <small>Category</small>
                            <strong>Author Session</strong>
                        </div>
                    </div>

                    <div class="summary-item">
                        <div class="summary-icon">👥</div>
                        <div class="summary-text">
                            <small>Audience</small>
                            <strong>Book Community</strong>
                        </div>
                    </div>

                </div>




            </div>

        </div>

    </div>
</div>
