@model IEnumerable<LibraryManagementSystem.ClassLibrary.Models.Event>

@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Events";
}

<style>

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: var(--bg) !important;
        color: var(--text) !important;
        font-family: 'Inter',sans-serif;
        overflow-x: hidden;
    }

    .events-page {
        min-height: 100vh;
        padding: 30px;
        background: radial-gradient(circle at top right, rgba(168,85,247,.18), transparent 25%), radial-gradient(circle at bottom left, rgba(236,72,153,.12), transparent 28%), var(--bg);
    }

    /* =========================================
       HERO SECTION (REFINED MATCH)
    ========================================= */

    .events-hero {
        position: relative;
        overflow: hidden;
        border-radius: 36px;
        padding: 80px 65px;
        margin-bottom: 60px;
        display: flex;
        align-items: center;
        background: linear-gradient( rgba(7,11,26,.88), rgba(15,23,42,.92) ), url('/images/library-banner.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    /* LIGHT MODE */
    body.light-mode .events-hero {
        background: linear-gradient( rgba(255,255,255,.90), rgba(248,250,252,.95) ), url('/images/library-banner.png');
        background-size: cover;
        background-position: center;
    }

    /* DECOR SHAPES (reduced intensity for cleaner look) */
    .events-hero::before {
        content: "";
        position: absolute;
        width: 380px;
        height: 380px;
        border-radius: 50%;
        background: rgba(168,85,247,.10);
        top: -170px;
        right: -120px;
    }

    .events-hero::after {
        content: "";
        position: absolute;
        width: 240px;
        height: 240px;
        border-radius: 50%;
        background: rgba(236,72,153,.08);
        bottom: -90px;
        left: -70px;
    }

    /* CONTENT WRAPPER */
    .hero-grid {
        position: relative;
        z-index: 2;
        width: 100%;
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 60px;
        align-items: center;
    }

    /* LEFT SECTION */
    .hero-left-event {
        max-width: 760px;
    }

    /* BADGE (aligned with reference style) */
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 22px;
        border-radius: 50px;
        background: rgba(255,255,255,.05);
        border: 1px solid var(--border);
        color: #c4b5fd;
        font-size: 13px;
        margin-bottom: 24px;
    }

    /* HEADING */
    .hero-left-event h1 {
        font-size: 62px;
        font-weight: 900;
        color: var(--text);
        margin-bottom: 20px;
        line-height: 1.05;
    }

        .hero-left-event h1 span {
            background: linear-gradient(90deg,#c084fc,#f0abfc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    /* PARAGRAPH */
    .hero-left-event p {
        color: var(--text-light);
        line-height: 1.9;
        max-width: 700px;
        font-size: 16px;
    }

    /* ACTIONS */
    .hero-actions {
        margin-top: 28px;
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
    }
    /* BUTTONS */

    .btn-main {
        padding: 16px 32px;
        border-radius: 18px;
        background: linear-gradient(90deg,#7c3aed,#9333ea);
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: .35s;
        box-shadow: 0 10px 25px rgba(139,92,246,.25);
    }

        .btn-main:hover {
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 18px 35px rgba(139,92,246,.35);
        }

    .btn-glass {
        padding: 16px 28px;
        border-radius: 18px;
        text-decoration: none;
        font-weight: 700;
        color: var(--text);
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        transition: .35s;
        backdrop-filter: blur(12px);
    }

        .btn-glass:hover {
            background: rgba(255,255,255,.08);
            color: var(--text);
            transform: translateY(-3px);
        }

    /* =========================================
               EVENTS GRID
        ========================================= */

    .events-listing {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(320px,1fr));
        gap: 30px;
    }

    /* =========================================
               EVENT CARD
        ========================================= */

    .premium-event-card {
        overflow: hidden;
        border-radius: 30px;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        transition: .35s;
        backdrop-filter: blur(16px);
        box-shadow: 0 10px 35px rgba(0,0,0,.25);
    }

        .premium-event-card:hover {
            transform: translateY(-10px);
            border-color: rgba(139,92,246,.35);
            box-shadow: 0 25px 55px rgba(139,92,246,.18);
        }

    /* IMAGE */

    .premium-event-image {
        position: relative;
        height: 240px;
        overflow: hidden;
        background: #111827;
    }

        .premium-event-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: .45s;
        }

    .premium-event-card:hover .premium-event-image img {
        transform: scale(1.05);
    }

    .premium-event-image::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,.55), transparent);
    }

    /* CONTENT */

    .premium-event-content {
        padding: 24px;
    }

    .event-date {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 50px;
        background: rgba(139,92,246,.12);
        color: #d8b4fe;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 18px;
        white-space: nowrap;
        width: fit-content;
    }

    .event-title {
        color: var(--text);
        font-size: 26px;
        line-height: 1.3;
        font-weight: 800;
        margin-bottom: 18px;
        min-height: 68px;
    }

    .event-details {
        display: grid;
        gap: 12px;
        margin-bottom: 24px;
    }

    .detail-box {
        padding: 16px;
        border-radius: 18px;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
    }

        .detail-box small {
            display: block;
            margin-bottom: 8px;
            color: #c4b5fd;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .detail-box span {
            color: var(--text);
            font-size: 14px;
            font-weight: 600;
        }

    .premium-event-btn {
        width: 100%;
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 15px;
        border-radius: 18px;
        background: linear-gradient(90deg,#7c3aed,#9333ea);
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: .35s;
        box-shadow: 0 10px 25px rgba(139,92,246,.25);
    }

        .premium-event-btn:hover {
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 18px 35px rgba(139,92,246,.35);
        }

    /* EMPTY STATE */

    .empty-box {
        padding: 90px 30px;
        text-align: center;
        border-radius: 30px;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
    }

        .empty-box img {
            width: 120px;
            margin-bottom: 20px;
        }

        .empty-box h3 {
            color: var(--text);
            font-size: 32px;
            margin-bottom: 10px;
        }

        .empty-box p {
            color: var(--text-muted);
        }

    /* PAGINATION */

    .pagination-wrapper {
        margin-top: 60px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .page-btn {
        padding: 14px 28px;
        border-radius: 16px;
        background: linear-gradient(90deg,#7c3aed,#9333ea);
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: .35s;
        box-shadow: 0 10px 25px rgba(139,92,246,.25);
    }

        .page-btn:hover {
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 18px 35px rgba(139,92,246,.35);
        }

    .page-number {
        color: var(--text);
        font-weight: 700;
        padding: 14px 22px;
        border-radius: 14px;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
    }

    /* RESPONSIVE */

    @@media(max-width:992px) {

        .events-hero {
            min-height: auto;
            padding: 70px 40px;
        }

        .hero-grid {
            grid-template-columns: 1fr;
        }

        .hero-left-event h1 {
            font-size: 54px;
        }
    }

    @@media(max-width:768px) {

        .events-page {
            padding: 16px;
        }

        .events-hero {
            min-height: auto;
            padding: 55px 24px;
            border-radius: 28px;
            margin-bottom: 40px;
        }

        .hero-left-event h1 {
            font-size: 40px;
        }

        .hero-left-event p {
            font-size: 15px;
        }

        .hero-actions {
            flex-direction: column;
        }

        .btn-main,
        .btn-glass {
            width: 100%;
            text-align: center;
        }

        .events-listing {
            grid-template-columns: 1fr;
        }

        .premium-event-image {
            height: 220px;
        }
    }
</style>

<div class="events-page">

    <!-- HERO -->

    <section class="events-hero">

        <div class="hero-grid">

            <div class="hero-left-event">

                <div class="hero-badge">
                    ✨ PREMIUM LIBRARY EVENTS
                </div>

                <h1>
                    Discover Amazing
                    <span>Library Events</span>
                </h1>

                <p>
                    Join workshops, reading sessions, author meetups,
                    educational programs and premium community events
                    designed for passionate readers and learners.
                </p>

                <div class="hero-actions">

                    <a href="#eventsList" class="btn-main">
                        Browse Events
                    </a>

                    <a asp-action="Past" class="btn-glass">
                        View Past Events
                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- EVENTS -->

    <div class="events-listing" id="eventsList">

        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="premium-event-card">

                    <!-- IMAGE -->

                    <div class="premium-event-image">

                        <img src="@(string.IsNullOrEmpty(item.ImagePath)
                                                                                      ? "/images/default-book.jpg"
                                                                                      : item.ImagePath)" />

                    </div>

                    <!-- CONTENT -->

                    <div class="premium-event-content">

                        <div class="event-date">
                            📅 @item.Date.ToString("dd MMM yyyy")
                        </div>

                        <div class="event-title">
                            @item.Title
                        </div>

                        <div class="event-details">

                            <div class="detail-box">

                                <small>Location</small>

                                <span>
                                    📍 @item.Location
                                </span>

                            </div>

                            <div class="detail-box">

                                <small>Event Time</small>

                                <span>
                                    ⏰ @item.Date.ToString("hh:mm tt")
                                </span>

                            </div>

                        </div>

                        <a asp-controller="Events"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="premium-event-btn">

                            Explore Event →

                        </a>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="empty-box">

                <img src="https://cdn-icons-png.flaticon.com/512/7486/7486740.png" />

                <h3>No Events Found</h3>

                <p>
                    There are currently no upcoming events available.
                </p>

            </div>
        }

    </div>

    @if (ViewBag.TotalPages > 1)
    {
        <div class="pagination-wrapper">

            @if (ViewBag.CurrentPage > 1)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage - 1)"
                   asp-route-searchQuery="@ViewBag.SearchQuery"
                   class="page-btn">

                    ← Previous

                </a>
            }

            <div class="page-number">
                Page @ViewBag.CurrentPage of @ViewBag.TotalPages
            </div>

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-page="@(ViewBag.CurrentPage + 1)"
                   asp-route-searchQuery="@ViewBag.SearchQuery"
                   class="page-btn">

                    Next →

                </a>
            }

        </div>
    }

</div>
