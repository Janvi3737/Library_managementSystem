@model Library_Management_System.ViewModels.CatalogViewModel

@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "New Arrivals";
}

<link rel="stylesheet" href="~/css/book-arrival-card.css" />


<style>

    body {
        background: #070b1a;
        color: white;
        font-family: 'Inter',sans-serif;
    }

    .arrivals-page {
        padding: 25px 0 80px;
    }

    /* HERO */

    .arrivals-hero {
        position: relative;
        overflow: hidden;
        border-radius: 36px;
        padding: 80px 65px;
        margin-bottom: 60px;
        background: linear-gradient( rgba(7,11,26,.88), rgba(15,23,42,.92) ), url('/images/library-banner.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
    }

    /* LIGHT MODE */
    body.light-mode .arrivals-hero {
        background: linear-gradient( rgba(255,255,255,.90), rgba(248,250,252,.95) ), url('/images/library-banner.png');
        background-size: cover;
        background-position: center;
    }

    /* DECOR SHAPES */
    .arrivals-hero::before {
        content: "";
        position: absolute;
        width: 380px;
        height: 380px;
        border-radius: 50%;
        background: rgba(168,85,247,.10);
        top: -170px;
        right: -120px;
    }

    .arrivals-hero::after {
        content: "";
        position: absolute;
        width: 240px;
        height: 240px;
        border-radius: 50%;
        background: rgba(236,72,153,.08);
        bottom: -90px;
        left: -70px;
    }

    /* CONTENT */
    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 760px;
    }

    /* BADGE */
    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 22px;
        border-radius: 50px;
        background: rgba(255,255,255,.05);
        border: 1px solid var(--border);
        color: #c4b5fd;
        font-size: 13px;
        margin-bottom: 24px;
    }

    /* TITLE */
    .hero-content h1 {
        font-size: 62px;
        font-weight: 900;
        line-height: 1.05;
        color: var(--text);
        margin-bottom: 20px;
    }

        .hero-content h1 span {
            background: linear-gradient(90deg,#c084fc,#f0abfc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

    /* TEXT */
    .hero-content p {
        color: var(--text-light);
        line-height: 1.9;
        font-size: 16px;
        max-width: 700px;
    }

    /* ================================
       ARRIVAL BOOK CARD (FIXED UI)
    ================================ */

    .arrival-book-card {
        background: var(--card);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        border-radius: 24px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: all .3s ease;
    }

        .arrival-book-card:hover {
            transform: translateY(-6px);
        }

    /* IMAGE SECTION */
    .arrival-book-image {
        position: relative;
        height: 260px;
        overflow: hidden;
    }

        .arrival-book-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .4s ease;
        }

    .arrival-book-card:hover .arrival-book-image img {
        transform: scale(1.06);
    }

    /* BADGE */
    .arrival-new-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        background: rgba(124,58,237,.15);
        border: 1px solid var(--border);
        color: #c4b5fd;
        backdrop-filter: blur(10px);
    }

    /* CONTENT */
    .arrival-book-content {
        padding: 16px 16px 18px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        background: var(--card);
        color: var(--text);
    }

    /* CATEGORY */
    .arrival-category-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        background: rgba(255,255,255,.05);
        border: 1px solid var(--border);
        color: var(--text-light);
        width: fit-content;
    }

    /* TITLE */
    .arrival-book-title {
        font-size: 18px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.3;
    }

    /* AUTHOR */
    .arrival-book-author {
        font-size: 13px;
        color: var(--text-muted);
    }

    /* DESCRIPTION */
    .arrival-book-description {
        font-size: 13px;
        line-height: 1.6;
        color: var(--text-light);
    }

    /* DATE */
    .arrival-book-date {
        font-size: 12px;
        color: var(--text-muted);
        margin-top: 4px;
    }

    /* FOOTER */
    .arrival-book-footer {
        margin-top: 12px;
    }

    /* BUTTON */
    .arrival-details-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 14px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        background: linear-gradient( 135deg, var(--primary), var(--primary-light) );
        color: white !important;
        text-decoration: none;
        transition: .3s ease;
    }

        .arrival-details-btn:hover {
            transform: translateY(-2px);
            opacity: .95;
        }
    /* GRID (if you use split layout) */
    .hero-grid {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 1.2fr .8fr;
        gap: 60px;
        align-items: center;
    }

    .arrival-book-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(260px,1fr));
        gap: 28px;
    }


    /* EMPTY */

    .empty-box {
        padding: 80px 30px;
        text-align: center;
        border-radius: 30px;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.08);
    }

        .empty-box h3 {
            font-size: 32px;
            margin-bottom: 12px;
        }

        .empty-box p {
            color: #94a3b8;
        }

    @@media(max-width:768px) {

        .arrivals-hero {
            padding: 55px 30px;
            border-radius: 28px;
        }

        .hero-content h1 {
            font-size: 42px;
        }

        .arrival-book-grid {
            grid-template-columns: repeat(2,1fr);
            gap: 16px;
        }
    }
</style>


<div class="container arrivals-page">

    <section class="arrivals-hero">

        <div class="hero-content">

            <div class="hero-badge">
                🆕 LATEST LIBRARY COLLECTION
            </div>

            <h1>
                New
                <span>Arrivals</span>
            </h1>

            <p>
                Explore recently added books from the last
                30 days including trending novels,
                educational resources and technology books.
            </p>

        </div>

    </section>


    @if (Model.PagedBooks != null && Model.PagedBooks.Any())
    {
        <div class="arrival-book-grid">

            @foreach (var book in Model.PagedBooks)
            {
                <div class="arrival-book-card">

                    <div class="arrival-book-image">

                        <img src="@(string.IsNullOrEmpty(book.CoverImageUrl)
                                                          ? "/images/default-book.jpg"
                                                          : book.CoverImageUrl)" />

                        <div class="arrival-new-badge">
                            🆕 New Arrival
                        </div>

                    </div>


                    <div class="arrival-book-content">

                        <div class="arrival-category-pill">

                            📚
                            @(book.Category?.Name
                                                ?? "Unknown")

                        </div>


                        <h2 class="arrival-book-title">
                            @book.Title
                        </h2>

                        <div class="arrival-book-author">

                            ✍️
                            @(book.Author?.Name
                                                ?? "Unknown Author")

                        </div>


                        <div class="arrival-book-description">

                            @(string.IsNullOrEmpty(book.Description)
                                                ? "No description available."
                                                : (book.Description.Length > 100
                                                ? book.Description.Substring(0, 100) + "..."
                                                : book.Description))

                        </div>


                        <div class="arrival-book-date">

                            📅 Added:
                            @book.CreatedAt.ToString("dd MMM yyyy")

                        </div>


                        <div class="arrival-book-footer">

                            <a asp-controller="Catalog"
                               asp-action="Details"
                               asp-route-id="@book.Id"
                               class="arrival-details-btn">

                                View Details →

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {

        <div class="empty-box">

            <h3>No New Arrivals</h3>

            <p>
                No books were added in the last 30 days
            </p>

        </div>

    }

</div>
