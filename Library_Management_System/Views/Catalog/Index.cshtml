@model Library_Management_System.ViewModels.CatalogViewModel
@using System.Linq

@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
    ViewData["Title"] = "Browse Books";
}

<link rel="stylesheet" href="~/css/book-card.css" />


<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

    :root {
        /* DARK MODE */

        --bg: #050816;
        --bg2: #0b1120;
        --card: #111827;
        --card2: #1e293b;
        --text: #ffffff;
        --text-light: #d1d5db;
        --text-muted: #94a3b8;
        --primary: #7c3aed;
        --primary-light: #a855f7;
        --pink: #d946ef;
        --border: rgba(255,255,255,.08);
        --shadow: 0 15px 40px rgba(0,0,0,.35);
        --hero-overlay: linear-gradient( rgba(5,8,22,.85), rgba(15,23,42,.92) );
    }

    /* ===================================
       LIGHT MODE
    =================================== */

    body.light-mode {
        --bg: #f6f8fc;
        --bg2: #ffffff;
        --card: #ffffff;
        --card2: #f8fafc;
        --text: #111827;
        --text-light: #4b5563;
        --text-muted: #6b7280;
        --primary: #7c3aed;
        --primary-light: #9333ea;
        --pink: #d946ef;
        --border: rgba(124,58,237,.10);
        --shadow: 0 12px 35px rgba(124,58,237,.08);
        --hero-overlay: linear-gradient( rgba(255,255,255,.92), rgba(248,250,252,.96) );
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        font-family: 'Inter',sans-serif;
        background: radial-gradient( circle at top left, rgba(124,58,237,.15), transparent 25% ), radial-gradient( circle at bottom right, rgba(217,70,239,.10), transparent 35% ), var(--bg);
        color: var(--text);
        transition: .35s ease;
    }

    .catalog-page {
        width: 100%;
        min-height: 100vh;
        padding: 35px 24px 80px;
    }

    /* HERO */
    .catalog-hero {
        position: relative;
        overflow: hidden;
        padding: 80px 60px;
        border-radius: 32px;
        background: var(--hero-overlay), url('/images/library-banner.png');
        background-size: cover;
        background-position: center;
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        margin-bottom:30px;
    }

        .catalog-hero::before {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            top: -180px;
            right: -150px;
            border-radius: 50%;
            background: rgba(168,85,247,.20);
            filter: blur(90px);
        }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 720px;
    }
        .hero-content h1 {
            font-size: 68px;
            font-weight: 900;
            line-height: 1.1;
            color: var(--text);
        }

            .hero-content h1 span {
                background: linear-gradient( 90deg, #7c3aed, #d946ef );
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .hero-content p {
            color: var(--text-light);
            font-size: 16px;
            line-height: 1.9;
        }

    .hero-badge {
        display: inline-flex;
        padding: 12px 22px;
        border-radius: 999px;
        background: rgba(124,58,237,.10);
        border: 1px solid rgba(124,58,237,.20);
        color: #c084fc;
        font-weight: 700;
    }
    /* FILTER */

    .filter-box {
        background: var(--card);
        border: 1px solid var(--border);
        box-shadow: var(--shadow);
        border-radius: 30px;
        padding: 32px;
        margin-bottom:30px;
    }

    .filter-title {
        color: var(--text);
        font-size: 42px;
        font-weight: 900;
    }

    .filter-form {
        display: flex;
        gap: 18px;
        align-items: center;
        flex-wrap: wrap;
    }

    .filter-item {
        flex: 1;
        min-width: 180px;
    }

    .filter-search {
        flex: 1.5;
    }

    .custom-input,
    .custom-select {
        width: 100%;
        height: 60px;
        border-radius: 20px;
        background: var(--card2);
        color: var(--text);
        border: 1px solid var(--border);
        padding: 0 20px;
        transition: .3s;
    }

        .custom-input:focus,
        .custom-select:focus {
            border-color: var(--primary);
            background: var(--card2);
            color: var(--text);
            box-shadow: 0 0 0 4px rgba(124,58,237,.15);
        }

        .custom-input::placeholder {
            color: var(--text-muted);
        }

        .custom-select option {
            background: var(--card2);
            color: var(--text);
        }

    .filter-btn {
        width: 140px;
    }

    .search-btn {
        height: 60px;
        width:100px;
        border: none;
        border-radius: 20px;
        color: white;
        font-weight: 700;
        background: linear-gradient( 135deg, #7c3aed, #d946ef );
        box-shadow: 0 12px 30px rgba(124,58,237,.30);
        transition: .3s;
    }

        .search-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 40px rgba(124,58,237,.35);
        }

    @@media(max-width:1200px) {

        .filter-form {
            flex-direction: column;
        }

        .filter-item,
        .filter-search,
        .filter-btn {
            width: 100%;
        }
    }

    @@media(max-width:768px) {

        .filter-box {
            padding: 22px;
            border-radius: 24px;
        }

        .filter-title {
            font-size: 30px;
        }

        .custom-input,
        .custom-select,
        .search-btn {
            height: 58px;
            font-size: 16px;
            border-radius: 18px;
        }
    }
    /* WISHLIST */

    .wishlist-container {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 5;
    }

    .wishlist-btn {
        width: 42px;
        height: 42px;
        border: none;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        transition: .3s ease;
        background: rgba(17,24,39,.95);
        border: 1px solid rgba(255,255,255,.08);
        backdrop-filter: blur(12px);
        box-shadow: 0 8px 20px rgba(0,0,0,.25);
    }

        .wishlist-btn i {
            color: #d1d5db;
            font-size: 16px;
            transition: .3s ease;
        }

        .wishlist-btn:hover {
            transform: scale(1.08);
            border-color: rgba(124,58,237,.40);
            box-shadow: 0 10px 25px rgba(124,58,237,.25);
        }

            .wishlist-btn:hover i {
                color: #c084fc;
            }

        /* ACTIVE */

        .wishlist-btn.active {
            background: linear-gradient( 135deg, #ff4b6e, #ff758c );
            border-color: transparent;
        }

            .wishlist-btn.active i {
                color: white;
            }

    /* LIGHT MODE */

    body.light-mode .wishlist-btn {
        background: #ffffff;
        border: 1px solid rgba(124,58,237,.10);
        box-shadow: 0 8px 20px rgba(124,58,237,.08);
    }

        body.light-mode .wishlist-btn i {
            color: #7c3aed;
        }

        body.light-mode .wishlist-btn:hover {
            border-color: #7c3aed;
        }

        body.light-mode .wishlist-btn.active {
            background: linear-gradient( 135deg, #ff4b6e, #ff758c );
        }

            body.light-mode .wishlist-btn.active i {
                color: white;
            }
    /* STATUS */

    .status-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 18px;
    }

    .status-box {
        padding: 12px;
        background: var(--card2);
        border: 1px solid var(--border);
        border-radius: 16px;
        text-align: center;
    }

        .status-box small {
            display: block;
            margin-bottom: 5px;
            font-size: 9px;
            font-weight: 700;
        }

        .status-box span {
            font-size: 13px;
        }

    .available-box {
        background: rgba(34,197,94,.08);
    }
        .available-box small {
            color: #86efac;
        }

    .borrow-box {
        background: rgba(124,58,237,.08);
    }
        .borrow-box small {
            color: #d8b4fe;
        }


    /* EMPTY */

    .empty-box {
        padding: 80px;
        text-align: center;
        border-radius: 30px;
        background: linear-gradient( 180deg, rgba(17,24,39,.96), rgba(10,15,28,.98));
    }

    /* PAGINATION */

    .pagination-wrapper {
        margin-top: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 22px;
        flex-wrap: wrap;
    }

    .pagination-btn {
        padding: 14px 28px;
        border-radius: 18px;
        background: linear-gradient( 135deg, #7c3aed, #d946ef );
        color: white;
        text-decoration: none;
        font-weight: 700;
        transition: .35s;
        box-shadow: 0 10px 25px rgba(168,85,247,.25);
    }

        .pagination-btn:hover {
            transform: translateY(-3px);
            color: white;
            box-shadow: 0 18px 35px rgba(168,85,247,.35);
        }

    .pagination-info {
        padding: 14px 24px;
        border-radius: 18px;
        background: var(--card);
        color: var(--text);
        border: 1px solid var(--border);
        font-weight: 600;
    }

    @@media(max-width:768px) {

        .hero-content h1 {
            font-size: 40px;
        }

        .catalog-page {
            padding: 20px;
        }

        .status-wrapper {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="catalog-page">

    <section class="catalog-hero">

        <div class="hero-content">

            <div class="hero-badge">
                ✨ PREMIUM DIGITAL LIBRARY
            </div>

            <h1>
                Discover Your
                <span>Next Favorite Book</span>
            </h1>

            <p>
                Browse premium collections, explore authors,
                discover categories and find inspiring reads.
            </p>

        </div>

    </section>

    <!-- FILTER -->
    <div class="filter-box">

        <h3 class="filter-title">
            Browse Collection
        </h3>

        <form method="get"
              asp-action="Index"
              class="filter-form">

            <!-- SEARCH -->
            <div class="filter-item filter-search">

                <input type="text"
                       name="SearchQuery"
                       value="@Model.SearchQuery"
                       class="form-control custom-input"
                       placeholder="Search books..." />

            </div>

            <!-- CATEGORY -->
            <div class="filter-item">

                <select name="CategoryId"
                        class="form-select custom-select">

                    <option value="">All Categories</option>

                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id"
                                selected="@(Model.CategoryId == c.Id)">
                            @c.Name
                        </option>
                    }

                </select>

            </div>

            <!-- AUTHOR -->
            <div class="filter-item">

                <select name="AuthorId"
                        class="form-select custom-select">

                    <option value="">All Authors</option>

                    @foreach (var a in Model.Authors)
                    {
                        <option value="@a.Id"
                                selected="@(Model.AuthorId == a.Id)">
                            @a.Name
                        </option>
                    }

                </select>

            </div>

            <!-- STATUS -->
            <div class="filter-item">

                <select class="form-select custom-select"
                        name="Availability">

                    <option value="">All</option>
                    <option value="available">Available</option>
                    <option value="borrowed">Borrowed</option>

                </select>

            </div>

            <!-- SORT -->
            <div class="filter-item">

                <select class="form-select custom-select"
                        name="SortBy">

                    <option value="">Sort By</option>
                    <option value="latest">Latest</option>
                    <option value="popular">Popular</option>
                    <option value="title">Title</option>

                </select>

            </div>

            <!-- BUTTON -->
            <div class="filter-btn">

                <button type="submit"
                        class="search-btn">

                    Search

                </button>

            </div>

        </form>

    </div>

@if (Model.PagedBooks != null && Model.PagedBooks.Any())
{
        <div class="catalog-books-grid">

            @foreach (var book in Model.PagedBooks)
            {
                <div class="catalog-book-card">

                    <div class="wishlist-container">

                        <button type="button"
                                class="wishlist-btn @(ViewBag.WishlistIds.Contains(book.Id) ? "active" : "")"
                                data-bookid="@book.Id">

                            <i class="@(ViewBag.WishlistIds.Contains(book.Id)
                                                            ? "fa-solid fa-heart"
                                                            : "fa-regular fa-heart")"></i>

                        </button>

                    </div>

                    <div class="catalog-book-image">

                        <img src="@(string.IsNullOrEmpty(book.CoverImageUrl)
                                                      ? "/images/default-book.jpg"
                                                      : book.CoverImageUrl)"
                             alt="@book.Title" />

                    </div>

                    <div class="catalog-book-content">

                        <h3 class="catalog-book-title">
                            @book.Title
                        </h3>

                        <div class="catalog-book-author">
                            ✍️ @(book.Author?.Name ?? "Unknown Author")
                        </div>

                        <div class="status-wrapper">

                            <div class="status-box available-box">
                                <small>Available</small>
                                <span>📚 @book.AvailableCopies Left</span>
                            </div>

                            <div class="status-box borrow-box">
                                <small>Borrows</small>
                                <span>🔥 @book.BorrowCount Times</span>
                            </div>

                        </div>

                        <div class="catalog-book-footer">

                            <a asp-action="Details"
                               asp-route-id="@book.Id"
                               class="catalog-details-btn">

                                Explore Book →

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    @if (Model.TotalPages > 1)
    {
            <div class="pagination-wrapper">

                <!-- PREVIOUS -->
                @if (Model.PageNumber > 1)
                {
                    <a asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-authorId="@Model.AuthorId"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-availability="@Model.Availability"
                       class="pagination-btn">

                        ← Previous

                    </a>
                }

                <!-- PAGE INFO -->

                <div class="pagination-info">
                    Page @Model.PageNumber of @Model.TotalPages
                </div>

                <!-- NEXT -->
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a asp-action="Index"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-searchQuery="@Model.SearchQuery"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-authorId="@Model.AuthorId"
                       asp-route-sortBy="@Model.SortBy"
                       asp-route-availability="@Model.Availability"
                       class="pagination-btn">

                        Next →

                    </a>
                }

            </div>
    }
}

    <script src="~/js/wishlist.js"></script>
