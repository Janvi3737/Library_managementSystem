@{
    ViewData["Title"] = "Rules";
}

<style>
    body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        background: radial-gradient(circle at top right, rgba(124,58,237,0.18), transparent 35%), radial-gradient(circle at bottom left, rgba(236,72,153,0.10), transparent 35%), linear-gradient(135deg, #050816, #0b1120, #111827);
        color: #e5e7eb;
    }

    /* SECTION */
    .rules-section {
        min-height: 100vh;
        padding: 90px 0;
        background: radial-gradient(circle at top right, rgba(168, 85, 247, 0.25), transparent 35%), radial-gradient(circle at bottom left, rgba(99, 102, 241, 0.18), transparent 40%), linear-gradient(135deg, #faf5ff, #eef2ff);
    }

    /* HEADER */
    .rules-header {
        text-align: center;
        margin-bottom: 60px;
    }

        .rules-header h1 {
            font-size: 50px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -1px;
        }

        .rules-header p {
            font-size: 18px;
            color: #9ca3af;
            margin-top: 10px;
            line-height: 1.7;
        }

    /* CARD */
    .rule-card {
        height: 100%;
        padding: 30px 28px;
        border-radius: 26px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        backdrop-filter: blur(18px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.35);
        transition: 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        /* hover effect */
        .rule-card:hover {
            transform: translateY(-6px);
            border-color: rgba(139,92,246,0.35);
            box-shadow: 0 20px 45px rgba(0,0,0,0.45);
        }

        /* subtle glow */
        .rule-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0.06), transparent 60%);
            pointer-events: none;
        }

        /* TITLE */
        .rule-card h4 {
            color: #c084fc;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* TEXT */
        .rule-card p {
            color: #d1d5db;
            line-height: 1.8;
            font-size: 15.5px;
            margin: 0;
        }

    /* GRID SPACING IMPROVEMENT */
    .row.g-4 > div {
        display: flex;
    }

    /* MOBILE */
    @@media (max-width: 768px) {

        .rules-section {
            padding: 60px 0;
        }

        .rules-header h1 {
            font-size: 36px;
        }

        .rules-header p {
            font-size: 16px;
        }

        .rule-card {
            padding: 24px;
        }

            .rule-card h4 {
                font-size: 16px;
            }
    }
</style>

<section class="rules-section">

    <div class="container">

        <!-- HEADER -->

        <div class="rules-header">

            <h1>Library Rules</h1>

            <p>
                Please follow these guidelines for a better library experience
            </p>

        </div>

        <!-- RULES -->

        <div class="row g-4">

            <div class="col-md-6">

                <div class="rule-card">

                    <h4>📚 Borrowing Limit</h4>

                    <p>
                        Students can borrow a maximum of 3 books at a time.
                    </p>

                </div>

            </div>

            <div class="col-md-6">

                <div class="rule-card">

                    <h4>⏰ Late Fine</h4>

                    <p>
                        ₹5 fine will be charged per day after the due date.
                    </p>

                </div>

            </div>

            <div class="col-md-6">

                <div class="rule-card">

                    <h4>🤫 Maintain Silence</h4>

                    <p>
                        Keep silence inside the library to maintain a peaceful environment.
                    </p>

                </div>

            </div>

            <div class="col-md-6">

                <div class="rule-card">

                    <h4>📖 Book Care</h4>

                    <p>
                        Handle books carefully and avoid damaging library resources.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>
