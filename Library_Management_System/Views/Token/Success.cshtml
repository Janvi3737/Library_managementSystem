@{
    ViewData["Title"] = "Token Request Submitted";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>

    body {
        background: radial-gradient(circle at top left, rgba(245,158,11,.15), transparent 35%), #050816;
        color: white;
        font-family: 'Inter', sans-serif;
    }

    .success-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .success-card {
        width: 100%;
        max-width: 750px;
        text-align: center;
        background: rgba(15,23,42,.95);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 32px;
        padding: 50px;
        backdrop-filter: blur(20px);
        box-shadow: 0 25px 60px rgba(245,158,11,.15);
    }

    .success-icon {
        width: 120px;
        height: 120px;
        margin: auto;
        border-radius: 50%;
        background: linear-gradient(135deg,#f59e0b,#f97316);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 55px;
        margin-bottom: 30px;
        box-shadow: 0 20px 40px rgba(245,158,11,.35);
    }

    .success-title {
        font-size: 42px;
        font-weight: 900;
        margin-bottom: 15px;
    }

    .success-subtitle {
        color: #9ca3af;
        font-size: 17px;
        line-height: 1.8;
        margin-bottom: 35px;
    }

    .status-box {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 35px;
        text-align: left;
    }

    .status-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        color: #d1d5db;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }

        .status-item:last-child {
            border-bottom: none;
        }

        .status-item i {
            color: #22c55e;
            font-size: 18px;
        }

    .alert-box {
        background: rgba(245,158,11,.12);
        border: 1px solid rgba(245,158,11,.3);
        color: #fbbf24;
        padding: 18px;
        border-radius: 16px;
        margin-bottom: 30px;
        font-weight: 600;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-custom {
        padding: 14px 28px;
        border-radius: 16px;
        text-decoration: none;
        font-weight: 700;
        transition: .3s;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg,#f59e0b,#f97316);
        color: white;
    }

    .btn-secondary-custom {
        background: rgba(255,255,255,.06);
        color: white;
        border: 1px solid rgba(255,255,255,.08);
    }

    .btn-custom:hover {
        transform: translateY(-3px);
        color: white;
    }

</style>

<div class="success-page">

    <div class="success-card">

        <div class="success-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <div class="success-title">
            Token Request Submitted
        </div>

        <div class="success-subtitle">
            Your token payment has been submitted successfully.
            Our admin team will verify the payment and activate your token.
        </div>

        <div class="alert-box">
            ⏳ Waiting for Admin Approval
        </div>

        <div class="status-box">

            <div class="status-item">
                <i class="bi bi-check-circle-fill"></i>
                Payment Screenshot Uploaded
            </div>

            <div class="status-item">
                <i class="bi bi-check-circle-fill"></i>
                Token Request Created
            </div>

            <div class="status-item">
                <i class="bi bi-hourglass-split"></i>
                Waiting for Admin Verification
            </div>

            <div class="status-item">
                <i class="bi bi-book-fill"></i>
                Borrow Book After Approval
            </div>

        </div>

        <div class="status-box">

            <div class="status-item">
                <i class="bi bi-coin"></i>
                1 Token = 1 Book Borrow
            </div>

            <div class="status-item">
                <i class="bi bi-clock-history"></i>
                Return Within 3 Days
            </div>

            <div class="status-item">
                <i class="bi bi-arrow-repeat"></i>
                Refund Based On Book Condition
            </div>

            <div class="status-item">
                <i class="bi bi-exclamation-triangle-fill"></i>
                Maximum 3 Token Borrows Allowed
            </div>

        </div>

        <div class="action-buttons">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn-custom btn-primary-custom">

                Back To Home

            </a>

            <a asp-controller="Token"
               asp-action="BuyToken"
               class="btn-custom btn-secondary-custom">

                View Token Status

            </a>

        </div>

    </div>

</div>
