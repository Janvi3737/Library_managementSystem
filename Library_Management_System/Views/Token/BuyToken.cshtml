@{
    ViewData["Title"] = "Buy Token";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>

    body {
        background: #050816;
        color: white;
        font-family: 'Inter', sans-serif;
    }

    .token-page {
        min-height: 100vh;
        padding: 80px 20px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .token-card {
        width: 100%;
        max-width: 650px;
        background: rgba(15,23,42,.95);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 30px;
        padding: 40px;
        text-align: center;
        backdrop-filter: blur(20px);
        box-shadow: 0 20px 50px rgba(124,58,237,.25);
    }

    .token-icon {
        width: 100px;
        height: 100px;
        margin: auto;
        border-radius: 50%;
        background: linear-gradient(135deg,#f59e0b,#f97316);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        margin-bottom: 25px;
    }

    .token-title {
        font-size: 38px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .token-subtitle {
        color: #9ca3af;
        margin-bottom: 30px;
    }

    .price-box {
        background: rgba(255,255,255,.04);
        border-radius: 20px;
        padding: 25px;
        margin-bottom: 30px;
    }

    .price {
        font-size: 60px;
        font-weight: 900;
        color: #f59e0b;
    }

    .status-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 15px;
        margin-bottom: 25px;
    }

    .status-card {
        background: rgba(255,255,255,.04);
        border-radius: 18px;
        padding: 20px;
    }

    .status-value {
        font-size: 28px;
        font-weight: 800;
        color: #fbbf24;
    }

    .status-label {
        color: #9ca3af;
        font-size: 14px;
    }

    .feature-list {
        text-align: left;
        margin-bottom: 30px;
    }

    .feature-item {
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,.05);
    }

        .feature-item i {
            color: #22c55e;
            margin-right: 10px;
        }

    .buy-btn {
        width: 100%;
        border: none;
        border-radius: 18px;
        padding: 18px;
        font-size: 17px;
        font-weight: 800;
        color: white;
        background: linear-gradient(135deg,#f59e0b,#f97316);
        cursor: pointer;
        transition: .3s;
    }

        .buy-btn:hover {
            transform: translateY(-3px);
            color: #9333ea;
        }

        .buy-btn:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    .limit-box {
        background: rgba(239,68,68,.12);
        border: 1px solid rgba(239,68,68,.35);
        color: #fecaca;
        border-radius: 18px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .membership-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 16px;
        border-radius: 18px;
        text-decoration: none;
        color: white;
        font-weight: 800;
        background: linear-gradient(135deg,#7c3aed,#9333ea);
        margin-bottom: 20px;
    }

        .membership-btn:hover {
            color: white;
            transform: translateY(-2px);
        }

</style>

<div class="token-page">

    <div class="token-card">

        <div class="token-icon">
            <i class="bi bi-coin"></i>
        </div>

        <div class="token-title">
            Book Borrow Token
        </div>

        <div class="token-subtitle">
            Borrow books without purchasing a membership.
            Each token allows you to borrow 1 book only.
        </div>

        <div class="price-box">
            <div class="price">
                ₹@ViewBag.DepositAmount
            </div>

            <div>
                Refundable Security Deposit
            </div>
        </div>

        <div class="status-grid">

            <div class="status-card">
                <div class="status-value">
                    @(3 - ViewBag.TotalBorrowCount)
                </div>

                <div class="status-label">
                    Tokens Remaining
                </div>
            </div>

            <div class="status-card">
                <div class="status-value">
                    @ViewBag.TotalBorrowCount
                </div>

                <div class="status-label">
                    Tokens Used
                </div>
            </div>

        </div>

        @if (ViewBag.TotalBorrowCount >= 3)
        {
            <div class="limit-box">

                <h5>
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Token Limit Reached
                </h5>

                <p class="mb-0">
                    You have already used all 3 borrow tokens.
                    To continue borrowing books, please purchase a membership plan.
                </p>

            </div>

            <a asp-controller="Membership"
               asp-action="Index"
               class="membership-btn">

                <i class="bi bi-award-fill"></i>
                Upgrade To Membership

            </a>
        }
        else
        {
            <div class="feature-list">

                <div class="feature-item">
                    <i class="bi bi-check-circle-fill"></i>
                    1 Token = 1 Book Borrow
                </div>

                <div class="feature-item">
                    <i class="bi bi-check-circle-fill"></i>
                    Maximum 3 Tokens Per User
                </div>

                <div class="feature-item">
                    <i class="bi bi-check-circle-fill"></i>
                    Secure Refundable Deposit
                </div>

                <div class="feature-item">
                    <i class="bi bi-check-circle-fill"></i>
                    Fast Admin Approval
                </div>

                <div class="feature-item">
                    <i class="bi bi-check-circle-fill"></i>
                    Track Borrow Activity
                </div>

                <div class="feature-item">
                    <i class="bi bi-check-circle-fill"></i>
                    Membership Required After 3 Borrows
                </div>

            </div>

            <form asp-action="Checkout" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="bookId"
                       value="@ViewBag.BookId" />

                <button type="submit" class="buy-btn">

                    <i class="bi bi-credit-card"></i>
                    Purchase Borrow Token

                </button>

            </form>
        }

    </div>

</div>
