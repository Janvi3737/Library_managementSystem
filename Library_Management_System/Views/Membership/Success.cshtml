@{
    ViewData["Title"] = "Payment Success";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>

    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

    body {
        background: radial-gradient(circle at top left, rgba(124,58,237,.18), transparent 30%), radial-gradient(circle at bottom right, rgba(217,70,239,.12), transparent 30%), #050816;
        font-family: 'Inter', sans-serif;
        color: white;
        overflow-x: hidden;
        margin: 0;
    }

    /* PAGE */
    .success-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 60px 20px;
    }

    /* CARD */
    .success-card {
        width: 100%;
        max-width: 680px;
        background: linear-gradient(180deg, #0f172a, #081120);
        border-radius: 36px;
        padding: 50px;
        text-align: center;
        border: 1px solid rgba(255,255,255,.08);
        box-shadow: 0 25px 70px rgba(0,0,0,.55);
        position: relative;
        overflow: hidden;
    }

        /* GLOW */
        .success-card::before {
            content: "";
            position: absolute;
            width: 360px;
            height: 360px;
            background: rgba(168,85,247,.12);
            border-radius: 50%;
            top: -180px;
            right: -180px;
            filter: blur(50px);
        }

    /* ICON */
    .success-icon {
        width: 115px;
        height: 115px;
        margin: 0 auto 28px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #7c3aed, #d946ef);
        box-shadow: 0 18px 45px rgba(168,85,247,.35);
        position: relative;
        z-index: 2;
    }

        .success-icon i {
            font-size: 52px;
            color: white;
        }

    /* TITLE */
    .success-title {
        font-size: 46px;
        font-weight: 900;
        margin-bottom: 14px;
        background: linear-gradient(135deg, #fff, #d8b4fe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        position: relative;
        z-index: 2;
    }

    /* TEXT */
    .success-text {
        color: #9ca3af;
        line-height: 1.9;
        font-size: 16px;
        margin-bottom: 30px;
        position: relative;
        z-index: 2;
    }

    /* INFO BOX */
    .success-info {
        background: rgba(255,255,255,.03);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 22px;
        padding: 20px;
        margin-bottom: 30px;
        position: relative;
        z-index: 2;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }

        .info-row:last-child {
            border-bottom: none;
        }

    .info-label {
        color: #9ca3af;
        font-size: 14px;
    }

    .info-value {
        font-weight: 700;
        color: white;
        font-size: 14px;
    }

    /* STATUS BADGE */
    .status-badge {
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(34,197,94,.12);
        color: #4ade80;
        font-size: 12px;
        font-weight: 700;
        border: 1px solid rgba(34,197,94,.18);
    }

    /* BUTTONS */
    .success-actions {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
        position: relative;
        z-index: 2;
    }

    .success-btn {
        text-decoration: none;
        padding: 15px 26px;
        border-radius: 16px;
        font-weight: 800;
        transition: .25s ease;
        font-size: 14px;
    }

    .primary-btn {
        background: linear-gradient(135deg, #7c3aed, #d946ef);
        color: white;
    }

        .primary-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(168,85,247,.35);
        }

    .secondary-btn {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.08);
        color: white;
    }

        .secondary-btn:hover {
            background: rgba(255,255,255,.08);
            transform: translateY(-3px);
        }

    /* RESPONSIVE */
    @@media(max-width:768px) {

        .success-card {
            padding: 30px 20px;
            border-radius: 28px;
        }

        .success-title {
            font-size: 34px;
        }

        .success-text {
            font-size: 15px;
        }

        .success-actions {
            flex-direction: column;
        }

        .success-btn {
            width: 100%;
        }

        .success-icon {
            width: 95px;
            height: 95px;
        }

            .success-icon i {
                font-size: 42px;
            }
    }
</style>

<div class="success-page">

    <div class="success-card">

        <!-- ICON -->

        <div class="success-icon">
            <i class="bi bi-check2"></i>
        </div>

        <!-- TITLE -->

        <div class="success-title">
            Payment Submitted
        </div>

        <!-- TEXT -->

        <div class="success-text">

            Your membership payment has been submitted
            successfully. Our team will verify your payment
            shortly and activate your membership.

        </div>

        <!-- INFO -->

        <div class="success-info">

            <div class="info-row">

                <div class="info-label">
                    Membership Status
                </div>

                <div class="status-badge">
                    Pending Verification
                </div>

            </div>

            <div class="info-row">

                <div class="info-label">
                    Payment Date
                </div>

                <div class="info-value">
                    @DateTime.Now.ToString("dd MMM yyyy")
                </div>

            </div>

            <div class="info-row">

                <div class="info-label">
                    Support
                </div>

                <div class="info-value">
                    Library Team
                </div>

            </div>

        </div>

        <!-- BUTTONS -->

        <div class="success-actions">

            <a asp-controller="Home"
               asp-action="Index"
               class="success-btn primary-btn">

                Go To Home

            </a>

            <a asp-controller="Membership"
               asp-action="Index"
               class="success-btn secondary-btn">

                View Membership

            </a>

        </div>

    </div>

</div>
