@{
    ViewData["Title"] = "UPI Payment";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

    body {
        background: radial-gradient(circle at top left, rgba(124, 58, 237, .18), transparent 30%), radial-gradient(circle at bottom right, rgba(217, 70, 239, .12), transparent 30%), #050816;
        font-family: 'Inter', sans-serif;
        color: white;
        margin: 0;
        padding: 0;
    }

    /* PAGE */
    .payment-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 60px 20px;
    }

    /* CARD */
    .payment-card {
        width: 100%;
        max-width: 680px;
        background: linear-gradient(180deg, #0f172a, #081120);
        border-radius: 34px;
        padding: 42px;
        border: 1px solid rgba(255, 255, 255, .08);
        text-align: center;
        box-shadow: 0 25px 70px rgba(0, 0, 0, .55);
        backdrop-filter: blur(18px);
    }

    /* TITLE */
    .title {
        font-size: 40px;
        font-weight: 900;
        margin-bottom: 8px;
        background: linear-gradient(135deg, #fff, #d8b4fe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* PRICE */
    .price {
        font-size: 52px;
        font-weight: 900;
        color: #c084fc;
        margin-bottom: 28px;
    }

    /* PAYMENT METHODS */
    .payment-methods {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
        margin-bottom: 26px;
    }

    .method-card {
        background: rgba(255, 255, 255, .04);
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 18px;
        padding: 18px;
        cursor: pointer;
        transition: .25s ease;
    }

        .method-card:hover {
            transform: translateY(-4px);
            border-color: rgba(168, 85, 247, .35);
        }

        .method-card.active {
            border-color: #a855f7;
            background: rgba(168, 85, 247, .12);
            box-shadow: 0 12px 30px rgba(168, 85, 247, .25);
        }

    .method-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 10px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.12);
    }

        .method-icon img {
            width: 38px;
            height: 38px;
            object-fit: contain;
        }

    .method-card span {
        display: block;
        font-size: 14px;
        font-weight: 700;
        color: white;
    }

    /* DYNAMIC BOX */
    .dynamic-box {
        background: rgba(255, 255, 255, .03);
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 18px;
        padding: 20px;
        margin-bottom: 18px;
    }

    .dynamic-title {
        font-size: 16px;
        font-weight: 800;
        margin-bottom: 12px;
        color: #e9d5ff;
    }

    /* INPUTS */
    .dynamic-input,
    .upload-input {
        width: 100%;
        padding: 14px;
        border-radius: 14px;
        background: #0b1220;
        border: 1px solid rgba(255, 255, 255, .08);
        color: white;
        outline: none;
        transition: .25s ease;
        font-size: 14px;
    }

        .dynamic-input:focus,
        .upload-input:focus {
            border-color: #a855f7;
            box-shadow: 0 0 0 4px rgba(168, 85, 247, .15);
        }

    .upload-input {
        margin-bottom: 18px;
    }

    /* QR BOX */
    .qr-box {
        background: white;
        padding: 16px;
        border-radius: 20px;
        display: inline-block;
        margin-bottom: 20px;
        box-shadow: 0 12px 30px rgba(0, 0, 0, .25);
    }

    /* UPI BOX */
    .upi-box {
        background: rgba(255, 255, 255, .03);
        border: 1px solid rgba(255, 255, 255, .08);
        border-radius: 16px;
        padding: 16px;
        margin-bottom: 18px;
    }

        .upi-box div:first-child {
            color: #9ca3af;
            margin-bottom: 6px;
            font-size: 13px;
        }

    .upi-id {
        color: #d8b4fe;
        font-size: 18px;
        font-weight: 800;
        word-break: break-word;
    }

    /* INFO */
    .info {
        color: #9ca3af;
        font-size: 14px;
        line-height: 1.7;
        margin-bottom: 22px;
    }

    /* BUTTON */
    .pay-btn {
        width: 100%;
        border: none;
        padding: 16px;
        border-radius: 16px;
        background: linear-gradient(135deg, #7c3aed, #d946ef);
        color: white;
        font-size: 15px;
        font-weight: 800;
        cursor: pointer;
        transition: .25s ease;
    }

        .pay-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(168, 85, 247, .3);
        }

    /* RESPONSIVE */
    @@media (max-width: 768px) {

        .payment-card {
            padding: 24px;
            border-radius: 26px;
        }

        .title {
            font-size: 30px;
        }

        .price {
            font-size: 40px;
        }

        .payment-methods {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="payment-page">

    <div class="payment-card">

        <div class="title">
            Complete Payment
        </div>

        <div class="price">
            ₹@ViewBag.Fee
        </div>

        <!-- PAYMENT METHODS -->

        <div class="payment-methods">

            <!-- PHONEPE -->

            <div class="method-card active" data-method="phonepe">
                <div class="method-icon phonepe-icon">
                    <img src="~/images/payment/phonepe.png" alt="PhonePe">
                </div>
                <span>PhonePe</span>
            </div>

            <div class="method-card" data-method="gpay">
                <div class="method-icon gpay-icon">
                    <img src="~/images/payment/gpay.png" alt="Google Pay">
                </div>
                <span>Google Pay</span>
            </div>

            <div class="method-card" data-method="paytm">
                <div class="method-icon paytm-icon">
                    <img src="~/images/payment/paytm.png" alt="Paytm">
                </div>
                <span>Paytm</span>
            </div>

            <div class="method-card" data-method="bhim">
                <div class="method-icon bhim-icon">
                    <img src="~/images/payment/bhim.png" alt="BHIM">
                </div>
                <span>BHIM UPI</span>
            </div>

        </div>

        <!-- DYNAMIC PAYMENT FORM -->

        <div id="dynamicPaymentForm"></div>

        <!-- UPI BOX -->

        <div class="upi-box">

            <div>
                Pay To UPI ID
            </div>

            <div class="upi-id">
                harshilinvest@okhdfcbank
            </div>

        </div>

        <div class="info">

            Scan QR using PhonePe, Google Pay,
            Paytm or BHIM and complete payment.

        </div>

        <!-- FORM -->

        <form asp-action="PaymentSuccess" method="post" enctype="multipart/form-data">

            <!-- PAYMENT METHOD -->

            <input type="hidden" id="paymentMethod" name="paymentMethod" />

            <!-- TRANSACTION ID -->

            <input type="text" name="transactionId" class="dynamic-input" placeholder="Enter Transaction ID" required
                   style="margin-bottom:20px;" />

            <!-- SCREENSHOT -->

            <input type="file" name="screenshot" class="upload-input" required />

            <button type="submit" class="pay-btn">

                I Have Paid

            </button>

        </form>

    </div>

</div>

<script>

    const cards =
        document.querySelectorAll(".method-card");

    const dynamicForm =
        document.getElementById("dynamicPaymentForm");

    const paymentMethodInput =
        document.getElementById("paymentMethod");

    // DEFAULT

    renderPayment("phonepe");

    // CLICK EVENT

    cards.forEach(card => {

        card.addEventListener("click", () => {

            cards.forEach(x =>
                x.classList.remove("active"));

            card.classList.add("active");

            const method =
                card.dataset.method;

            renderPayment(method);
        });
    });

    // RENDER PAYMENT

    function renderPayment(method) {

        // ================= PHONEPE =================

        if (method === "phonepe") {

            paymentMethodInput.value =
                "PhonePe";

            dynamicForm.innerHTML = `

                <div class="dynamic-box">

                    <div class="dynamic-title">
                        Pay with PhonePe
                    </div>

                    <input type="text"
                           class="dynamic-input"
                           placeholder="Enter PhonePe Number">

                </div>

                <div class="qr-box">

                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=harshilinvest@okhdfcbank&pn=LibraryMembership&am=@ViewBag.Fee&cu=INR"
                         width="220">

                </div>
            `;
        }

        // ================= GPAY =================

        else if (method === "gpay") {

            paymentMethodInput.value =
                "Google Pay";

            dynamicForm.innerHTML = `

                <div class="dynamic-box">

                    <div class="dynamic-title">
                        Pay with Google Pay
                    </div>

                    <input type="text"
                           class="dynamic-input"
                           placeholder="Enter Google Pay Number">

                </div>

                <div class="qr-box">

                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=harshilinvest@okhdfcbank&pn=LibraryMembership&am=@ViewBag.Fee&cu=INR"
                         width="220">

                </div>
            `;
        }

        // ================= PAYTM =================

        else if (method === "paytm") {

            paymentMethodInput.value =
                "Paytm";

            dynamicForm.innerHTML = `

                <div class="dynamic-box">

                    <div class="dynamic-title">
                        Pay with Paytm
                    </div>

                    <input type="text"
                           class="dynamic-input"
                           placeholder="Enter Paytm Number">

                </div>

                <div class="qr-box">

                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=harshilinvest@okhdfcbank&pn=LibraryMembership&am=@ViewBag.Fee&cu=INR"
                         width="220">

                </div>
            `;
        }

        // ================= BHIM =================

        else if (method === "bhim") {

            paymentMethodInput.value =
                "BHIM UPI";

            dynamicForm.innerHTML = `

                <div class="dynamic-box">

                    <div class="dynamic-title">
                        Pay with BHIM UPI
                    </div>

                    <input type="text"
                           class="dynamic-input"
                           placeholder="Enter UPI ID">

                </div>

                <div class="qr-box">

                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=harshilinvest@okhdfcbank&pn=LibraryMembership&am=@ViewBag.Fee&cu=INR"
                         width="220">

                </div>
            `;
        }
    }

</script>
