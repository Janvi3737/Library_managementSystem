@{
    ViewData["Title"] = "UPI Payment";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');

    body {
        background: #050816;
        font-family: 'Inter', sans-serif;
        color: white;
        margin: 0;
        padding: 0;
    }

    /* PAGE */

    .payment-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    /* CARD */

    .payment-card {
        width: 100%;
        max-width: 650px;
        background: linear-gradient(180deg,#0f172a,#081120);
        border-radius: 32px;
        padding: 40px;
        border: 1px solid rgba(255,255,255,.08);
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,.45);
    }

    /* TITLE */

    .title {
        font-size: 42px;
        font-weight: 900;
        margin-bottom: 10px;
        background: linear-gradient(135deg,#ffffff,#d8b4fe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .price {
        font-size: 56px;
        font-weight: 900;
        color: #c084fc;
        margin-bottom: 30px;
    }

    /* PAYMENT METHODS */

    .payment-methods {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 18px;
        margin-bottom: 30px;
    }

    .method-card {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 22px;
        padding: 22px;
        cursor: pointer;
        transition: .3s;
        text-align: center;
    }

        .method-card:hover {
            transform: translateY(-5px);
        }

        .method-card.active {
            border-color: #a855f7;
            background: rgba(168,85,247,.15);
            box-shadow: 0 12px 30px rgba(168,85,247,.25);
        }

    /* ICON BOX */

    .method-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 14px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,0.15);
    }

        .method-icon img {
            width: 42px;
            height: 42px;
            object-fit: contain;
        }

    /* BRAND COLORS */

    .phonepe-icon {
        background: linear-gradient(135deg,#f3e8ff,#ede9fe);
    }

    .gpay-icon {
        background: linear-gradient(135deg,#e8f0fe,#dbeafe);
    }

    .paytm-icon {
        background: linear-gradient(135deg,#e0f7ff,#cffafe);
    }

    .bhim-icon {
        background: linear-gradient(135deg,#fff1e6,#ffedd5);
    }

    .method-card span {
        display: block;
        font-size: 15px;
        font-weight: 700;
        color: white;
    }

    /* DYNAMIC BOX */

    .dynamic-box {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 22px;
        padding: 24px;
        margin-bottom: 25px;
    }

    .dynamic-title {
        font-size: 18px;
        font-weight: 800;
        margin-bottom: 15px;
    }

    /* INPUTS */

    .dynamic-input,
    .upload-input {
        width: 100%;
        padding: 16px;
        border-radius: 16px;
        background: #111827;
        border: 1px solid rgba(255,255,255,.08);
        color: white;
        outline: none;
        transition: .3s;
    }

        .dynamic-input:focus,
        .upload-input:focus {
            border-color: #a855f7;
            box-shadow: 0 0 0 4px rgba(168,85,247,.15);
        }

    .upload-input {
        margin-bottom: 20px;
    }

    /* QR BOX */

    .qr-box {
        background: white;
        padding: 20px;
        border-radius: 24px;
        display: inline-block;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(0,0,0,.2);
    }

        .qr-box img {
            display: block;
        }

    /* UPI BOX */

    .upi-box {
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 18px;
        padding: 18px;
        margin-bottom: 25px;
    }

        .upi-box div:first-child {
            color: #9ca3af;
            margin-bottom: 8px;
        }

    .upi-id {
        color: #d8b4fe;
        font-size: 20px;
        font-weight: 800;
        word-break: break-all;
    }

    /* INFO */

    .info {
        color: #9ca3af;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    /* BUTTON */

    .pay-btn {
        width: 100%;
        border: none;
        padding: 18px;
        border-radius: 18px;
        background: linear-gradient(135deg,#7c3aed,#d946ef);
        color: white;
        font-size: 16px;
        font-weight: 800;
        cursor: pointer;
        transition: .3s;
    }

        .pay-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(168,85,247,.3);
        }

    /* RESPONSIVE */

    @@media (max-width: 768px) {

        .payment-card {
            padding: 25px;
        }

        .title {
            font-size: 32px;
        }

        .price {
            font-size: 42px;
        }

        .payment-methods {
            grid-template-columns: 1fr;
        }

        .method-icon {
            width: 60px;
            height: 60px;
        }

            .method-icon img {
                width: 35px;
                height: 35px;
            }
    }
</style>

<div class="payment-page">

    <div class="payment-card">

        <div class="title">
            Complete Payment
        </div>

        <div class="price">
            ₹@ViewBag.Fee
        </div>

        <!-- PAYMENT METHODS -->

        <div class="payment-methods">

            <!-- PHONEPE -->

            <div class="method-card active" data-method="phonepe">
                <div class="method-icon phonepe-icon">
                    <img src="~/images/payment/phonepe.png" alt="PhonePe">
                </div>
                <span>PhonePe</span>
            </div>

            <div class="method-card" data-method="gpay">
                <div class="method-icon gpay-icon">
                    <img src="~/images/payment/gpay.png" alt="Google Pay">
                </div>
                <span>Google Pay</span>
            </div>

            <div class="method-card" data-method="paytm">
                <div class="method-icon paytm-icon">
                    <img src="~/images/payment/paytm.png" alt="Paytm">
                </div>
                <span>Paytm</span>
            </div>

            <div class="method-card" data-method="bhim">
                <div class="method-icon bhim-icon">
                    <img src="~/images/payment/bhim.png" alt="BHIM">
                </div>
                <span>BHIM UPI</span>
            </div>

        </div>

        <!-- DYNAMIC PAYMENT FORM -->

        <div id="dynamicPaymentForm"></div>

        <!-- UPI BOX -->

        <div class="upi-box">

            <div>
                Pay To UPI ID
            </div>

            <div class="upi-id">
                harshilinvest@okhdfcbank
            </div>

        </div>

        <div class="info">

            Scan QR using PhonePe, Google Pay,
            Paytm or BHIM and complete payment.

        </div>

        <!-- FORM -->

        <form asp-action="PaymentSuccess"
              method="post"
              enctype="multipart/form-data">

            <!-- PAYMENT METHOD -->

            <input type="hidden"
                   id="paymentMethod"
                   name="paymentMethod" />

            <!-- TRANSACTION ID -->

            <input type="text"
                   name="transactionId"
                   class="dynamic-input"
                   placeholder="Enter Transaction ID"
                   required
                   style="margin-bottom:20px;" />

            <!-- SCREENSHOT -->

            <input type="file"
                   name="screenshot"
                   class="upload-input"
                   required />

            <button type="submit"
                    class="pay-btn">

                I Have Paid

            </button>

        </form>

    </div>

</div>

<script>

    const cards =
        document.querySelectorAll(".method-card");

    const dynamicForm =
        document.getElementById("dynamicPaymentForm");

    const paymentMethodInput =
        document.getElementById("paymentMethod");

    // DEFAULT

    renderPayment("phonepe");

    // CLICK EVENT

    cards.forEach(card => {

        card.addEventListener("click", () => {

            cards.forEach(x =>
                x.classList.remove("active"));

            card.classList.add("active");

            const method =
                card.dataset.method;

            renderPayment(method);
        });
    });

    // RENDER PAYMENT

    function renderPayment(method) {

        // ================= PHONEPE =================

        if (method === "phonepe") {

            paymentMethodInput.value =
                "PhonePe";

            dynamicForm.innerHTML = `

                <div class="dynamic-box">

                    <div class="dynamic-title">
                        Pay with PhonePe
                    </div>

                    <input type="text"
                           class="dynamic-input"
                           placeholder="Enter PhonePe Number">

                </div>

                <div class="qr-box">

                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=harshilinvest@okhdfcbank&pn=LibraryMembership&am=@ViewBag.Fee&cu=INR"
                         width="220">

                </div>
            `;
        }

        // ================= GPAY =================

        else if (method === "gpay") {

            paymentMethodInput.value =
                "Google Pay";

            dynamicForm.innerHTML = `

                <div class="dynamic-box">

                    <div class="dynamic-title">
                        Pay with Google Pay
                    </div>

                    <input type="text"
                           class="dynamic-input"
                           placeholder="Enter Google Pay Number">

                </div>

                <div class="qr-box">

                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=harshilinvest@okhdfcbank&pn=LibraryMembership&am=@ViewBag.Fee&cu=INR"
                         width="220">

                </div>
            `;
        }

        // ================= PAYTM =================

        else if (method === "paytm") {

            paymentMethodInput.value =
                "Paytm";

            dynamicForm.innerHTML = `

                <div class="dynamic-box">

                    <div class="dynamic-title">
                        Pay with Paytm
                    </div>

                    <input type="text"
                           class="dynamic-input"
                           placeholder="Enter Paytm Number">

                </div>

                <div class="qr-box">

                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=harshilinvest@okhdfcbank&pn=LibraryMembership&am=@ViewBag.Fee&cu=INR"
                         width="220">

                </div>
            `;
        }

        // ================= BHIM =================

        else if (method === "bhim") {

            paymentMethodInput.value =
                "BHIM UPI";

            dynamicForm.innerHTML = `

                <div class="dynamic-box">

                    <div class="dynamic-title">
                        Pay with BHIM UPI
                    </div>

                    <input type="text"
                           class="dynamic-input"
                           placeholder="Enter UPI ID">

                </div>

                <div class="qr-box">

                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=harshilinvest@okhdfcbank&pn=LibraryMembership&am=@ViewBag.Fee&cu=INR"
                         width="220">

                </div>
            `;
        }
    }

</script>
