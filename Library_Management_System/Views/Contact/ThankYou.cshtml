@{
    ViewData["Title"] = "Message Received";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>

    body {
        min-height: 100vh;
        margin: 0;
        font-family: 'Inter', sans-serif;
        background: radial-gradient(circle at top right, rgba(139,92,246,0.18), transparent 25%), radial-gradient(circle at bottom left, rgba(168,85,247,0.14), transparent 30%), linear-gradient(135deg, #050816, #0b1120, #111827);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 24px;
        color: #fff;
    }

    /* WRAPPER */
    .thank-wrapper {
        width: 100%;
        max-width: 1100px;
    }

    /* MAIN CARD */
    .glass-card {
        display: flex;
        border-radius: 28px;
        overflow: hidden;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.08);
        backdrop-filter: blur(18px);
    }

    /* LEFT PANEL */
    .left-panel {
        width: 42%;
        padding: 50px 40px;
        background: linear-gradient(180deg, rgba(124,58,237,0.22), rgba(91,33,182,0.10));
        border-right: 1px solid rgba(255,255,255,0.08);
        display: flex;
        align-items: center;
    }

    .logo {
        width: 80px;
        height: 80px;
        border-radius: 18px;
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 36px;
        margin-bottom: 20px;
    }

    .left-panel h2 {
        font-size: 38px;
        font-weight: 800;
        margin-bottom: 14px;
    }

    .left-panel p {
        font-size: 14px;
        line-height: 1.8;
        color: #d1d5db;
    }

    .feature-list {
        margin-top: 20px;
        padding-left: 18px;
        color: #ddd6fe;
        font-size: 13px;
    }

        .feature-list li {
            margin-bottom: 8px;
        }

    /* RIGHT PANEL */
    .right-panel {
        width: 58%;
        padding: 60px 40px;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .success-circle {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        margin: 0 auto 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        background: rgba(124,58,237,0.15);
        border: 1px solid rgba(255,255,255,0.08);
    }

    .success-icon {
        font-size: 56px;
    }

    .title {
        font-size: 44px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .message {
        font-size: 15px;
        color: #d1d5db;
        line-height: 1.8;
        max-width: 420px;
        margin: 0 auto 25px;
    }

    /* BUTTON */
    .btn-home {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        padding: 12px 28px;
        border-radius: 14px;
        background: linear-gradient(90deg, #7c3aed, #9333ea);
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s ease;
    }

        .btn-home:hover {
            transform: translateY(-3px);
        }

    /* STATUS */
    .status-badge {
        margin-top: 18px;
        padding: 8px 16px;
        border-radius: 999px;
        background: rgba(34,197,94,0.12);
        color: #86efac;
        font-size: 12px;
    }

    /* RESPONSIVE */
    @@media (max-width: 992px) {
        .glass-card {
            flex-direction: column;
        }

        .left-panel,
        .right-panel {
            width: 100%;
        }

        .left-panel {
            border-right: none;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
    }

    @@media (max-width: 768px) {
        body {
            padding: 14px;
        }

        .left-panel,
        .right-panel {
            padding: 30px 20px;
        }

        .title {
            font-size: 34px;
        }
    }

</style>

<div class="thank-wrapper">

    <div class="glass-card">

        <!-- LEFT PANEL -->

        <div class="left-panel">

            <div class="left-content">

                <div class="logo">
                    📩
                </div>

                <h2>
                    Message<br />
                    Received
                </h2>

                <p>
                    Thank you for contacting our
                    BookVerse Library Management System.
                    Your message has been delivered
                    successfully to our support team.
                </p>

                <ul class="feature-list">

                    <li>Quick Response Support</li>

                    <li>Secure Communication</li>

                    <li>Professional Assistance</li>

                    <li>Student Friendly Service</li>

                </ul>

                <p class="quote">
                    “Knowledge grows when we connect.”
                </p>

            </div>

        </div>

        <!-- RIGHT PANEL -->

        <div class="right-panel">

            <div class="success-circle">

                <div class="success-icon">
                    ✅
                </div>

            </div>

            <h2 class="title">
                Thank You!
            </h2>

            <p class="message">

                Your message has been successfully submitted.
                Our library administration team will contact you
                shortly through your registered email address.

            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn-home">

                ⬅ Back To Home

            </a>

            <div class="status-badge">
                Message Sent Successfully
            </div>

        </div>

    </div>

</div>
