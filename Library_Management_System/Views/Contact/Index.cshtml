@{
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}
@model Library_Management_System.ViewModels.ContactFormViewModel

@{
    ViewData["Title"] = "Contact Us";
}

<style>

    body {
        margin: 0;
        font-family: 'Inter', sans-serif;
        background: radial-gradient(circle at top right, rgba(124,58,237,0.18), transparent 35%), radial-gradient(circle at bottom left, rgba(236,72,153,0.10), transparent 35%), linear-gradient(135deg, #050816, #0b1120, #111827);
        color: #e5e7eb;
    }

    /* CONTAINER */
    .contact-container {
        padding: 60px 15px;
    }

    /* HERO */
    .contact-hero {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 30px;
        padding: 60px 40px;
        margin-bottom: 30px;
        backdrop-filter: blur(18px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.35);
        position: relative;
        overflow: hidden;
    }

        .contact-hero::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            background: rgba(139,92,246,0.15);
            border-radius: 50%;
            top: -120px;
            right: -100px;
        }

        .contact-hero h1 {
            font-size: 48px;
            font-weight: 800;
            margin-bottom: 14px;
        }

        .contact-hero p {
            font-size: 16px;
            color: #cbd5e1;
            line-height: 1.8;
            max-width: 750px;
        }

    /* GRID */
    .contact-grid {
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 24px;
    }

    /* GLASS CARD */
    .glass-card {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 26px;
        padding: 32px;
        backdrop-filter: blur(18px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.35);
        transition: 0.3s ease;
    }

        .glass-card:hover {
            transform: translateY(-4px);
            border-color: rgba(139,92,246,0.3);
        }

    /* TITLE */
    .section-title {
        font-size: 26px;
        font-weight: 700;
        margin-bottom: 22px;
    }

    /* FORM */
    label {
        font-size: 13px;
        color: #a855f7;
        font-weight: 600;
        margin-bottom: 6px;
        display: block;
    }

    .form-control {
        height: 48px;
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.05);
        color: white;
        padding: 10px 14px;
        font-size: 14px;
        transition: 0.3s ease;
    }

        .form-control:focus {
            background: rgba(255,255,255,0.08);
            border-color: #a855f7;
            box-shadow: 0 0 0 4px rgba(168,85,247,0.15);
            color: white;
        }

    textarea.form-control {
        min-height: 140px;
        resize: none;
    }

    /* BUTTON */
    .btn-send {
        width: 100%;
        height: 52px;
        border-radius: 14px;
        border: none;
        background: linear-gradient(135deg, #7c3aed, #9333ea);
        color: white;
        font-weight: 700;
        transition: 0.3s ease;
    }

        .btn-send:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(124,58,237,0.35);
        }

    /* INFO */
    .info-box {
        margin-bottom: 22px;
    }

        .info-box h5 {
            font-size: 16px;
            color: #c084fc;
            margin-bottom: 6px;
        }

        .info-box p {
            font-size: 14px;
            color: #cbd5e1;
            line-height: 1.7;
            margin: 0;
        }

    /* MAP */
    .map-box {
        margin-top: 20px;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.08);
    }

        .map-box iframe {
            width: 100%;
            height: 260px;
            border: 0;
            filter: grayscale(20%);
        }

    /* MOBILE */
    @@media (max-width: 992px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {

        .contact-hero {
            padding: 40px 22px;
        }

            .contact-hero h1 {
                font-size: 34px;
            }

        .contact-container {
            padding: 40px 12px;
        }

        .glass-card {
            padding: 24px;
        }

        .section-title {
            font-size: 22px;
        }
    }
</style>

<div class="container-fluid contact-container">

    <!-- HERO -->

    <div class="contact-hero">

        <h1>📩 Contact Us</h1>

        <p>
            Have questions about books, borrowing,
            membership or library services?
            Contact our Library Management Team anytime.
        </p>

    </div>

    <!-- MAIN CONTENT -->

    <div class="contact-grid">

        <!-- CONTACT FORM -->

        <div class="glass-card">

            <h2 class="section-title">
                Send Message
            </h2>

            <form asp-action="Send" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="Name"></label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter your name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Email"></label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your email" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Subject"></label>

                    <input asp-for="Subject"
                           class="form-control"
                           placeholder="Enter subject" />

                    <span asp-validation-for="Subject"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="Message"></label>

                    <textarea asp-for="Message"
                              class="form-control"
                              placeholder="Write your message">
                    </textarea>

                    <span asp-validation-for="Message"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn-send">

                    Send Message

                </button>

            </form>

        </div>

        <!-- CONTACT INFO -->

        <div class="glass-card">

            <h2 class="section-title">
                Library Information
            </h2>

            <div class="info-box">

                <h5>📍 Address</h5>

                <p>
                    Library Management System<br />
                    Surat, Gujarat, India
                </p>

            </div>

            <div class="info-box">

                <h5>📧 Email</h5>

                <p>
                    library@gmail.com
                </p>

            </div>

            <div class="info-box">

                <h5>📞 Phone</h5>

                <p>
                    +91 9876543210
                </p>

            </div>

            <div class="info-box">

                <h5>🕒 Working Hours</h5>

                <p>
                    Monday - Saturday<br />
                    9:00 AM - 7:00 PM
                </p>

            </div>

            <!-- MAP -->

            <div class="map-box">

                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3719.514432837173!2d72.8311!3d21.1702!2m3!1f0!2f0!3f0!"
                        allowfullscreen=""
                        loading="lazy">
                </iframe>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
